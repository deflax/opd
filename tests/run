                    result, before, after = self.invoke_tty(
                        env={'OPD_GPU': mode}, stdin_data=answer, terminal_stderr=True)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'GPU risk not accepted', result.stdout)
                    self.assertEqual(before, after)
                    self.assertEqual(self.calls(), [])
                    self.assertFalse((self.repo / 'data').exists())
                    self.assertFalse(host_calls.exists())

    def test_gpu_risk_machine_modes_never_prompt_even_on_terminal(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        for mode in ('software', 'dri'):
            for args in (['--print', 'private-native-argument'],
                         ['--mode=rpc'], ['--mode=json'], ['acp']):
                with self.subTest(mode=mode, args=args):
                    result, before, after = self.invoke_tty(
                        *args, env={'OPD_GPU': mode}, stdin_data=b'ACCEPT\n',
                        terminal_stderr=True)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'GPU risk not accepted', result.stdout)
                    self.assertNotIn(b'Type ACCEPT', result.stdout)
                    self.assertNotIn(b'private-native-argument', result.stdout)
                    self.assertEqual(before, after)
                    self.assertEqual(self.calls(), [])
                    self.assertFalse((self.repo / 'data').exists())

    def test_darwin_default_display_rewriting_and_xquartz_access(self):
        host_calls, _ = self.mock_display('Darwin')
        for display in (None, '', ':0', ':1', '/tmp/launchd-test/org.xquartz:0',
                        '/private/tmp/com.apple.launchd.test/org.xquartz:0',
                        '/var/run/com.apple.launchd.test/org.xquartz:0', 'remote.example:2'):
            with self.subTest(display=display):
                self.reset_log()
                if host_calls.exists():
                    host_calls.unlink()
                call = self.launch(env={} if display is None else {'DISPLAY': display})
                expected = 'remote.example:2' if display == 'remote.example:2' else 'host.docker.internal:0'
                self.assertIn('DISPLAY=' + expected, values(call, '-e', '--env'))
                calls = [json.loads(line) for line in host_calls.read_text().splitlines()]
                self.assertEqual(calls, [
                    {'command': 'open', 'args': ['-g', '-a', 'XQuartz'], 'display': display},
                    {'command': 'xhost', 'args': ['+127.0.0.1'], 'display': display or ':0'},
                    {'command': 'xhost', 'args': ['+localhost'], 'display': display or ':0'},
                ])
                self.assertNotIn('/tmp/.X11-unix', mounts(call))
                self.assertNotIn('/tmp/.docker.xauth', mounts(call))

    def test_darwin_explicit_display_passes_through_without_rewriting(self):
        host_calls, _ = self.mock_display('Darwin')
        for override in ('remote.example:7', ':3', '/tmp/explicit/org.xquartz:0'):
            with self.subTest(override=override):
                self.reset_log()
                host_calls.unlink(missing_ok=True)
                call = self.launch(env={'DISPLAY': ':9', 'OPD_DISPLAY': override})
                self.assertIn('DISPLAY=' + override, values(call, '-e', '--env'))
                calls = [json.loads(line) for line in host_calls.read_text().splitlines()]
                self.assertEqual([entry['args'] for entry in calls],
                                 [['-g', '-a', 'XQuartz'], ['+127.0.0.1'], ['+localhost']])
                self.assertTrue(all(entry['display'] == ':9' for entry in calls))

    def test_darwin_empty_display_override_disables_all_host_actions(self):
        host_calls, socket = self.mock_display('Darwin')
        authority = self.home / 'test.xauth'
        authority.write_bytes(b'synthetic authority\n')
        call = self.launch(env={'DISPLAY': ':9', 'OPD_DISPLAY': '',
                                'XAUTHORITY': str(authority)})
        self.assertFalse(host_calls.exists(), 'Disabled display must not open XQuartz or invoke xhost')
        self.assertFalse(any(item.split('=', 1)[0] in ('DISPLAY', 'XAUTHORITY')
                             for item in values(call, '-e', '--env')))
        self.assertNotIn(socket, mounts(call).values())
        self.assertNotIn('/tmp/.docker.xauth', mounts(call))

    def test_linux_display_mounts_socket_and_authority_readonly(self):
        host_calls, socket = self.mock_display('Linux')
        authority = self.home / 'test authority.xauth'
        authority.write_bytes(b'synthetic authority\n')
        for override in (None, 'remote.example:7'):
            with self.subTest(override=override):
                self.reset_log()
                env = {'DISPLAY': ':4', 'XAUTHORITY': str(authority)}
                if override is not None:
                    env['OPD_DISPLAY'] = override
                call = self.launch(env=env)
                self.assertIn(f'type=bind,source={socket},target=/tmp/.X11-unix,readonly',
                              values(call, '--mount'))
                self.assertIn(f'type=bind,source={authority},target=/tmp/.docker.xauth,readonly',
                              values(call, '--mount'))
                self.assertIn('DISPLAY=' + (override or ':4'), values(call, '-e', '--env'))
                self.assertIn('XAUTHORITY=/tmp/.docker.xauth', values(call, '-e', '--env'))
                self.assertFalse(host_calls.exists())

    def test_linux_empty_display_override_adds_no_display_resources(self):
        host_calls, socket = self.mock_display('Linux')
        authority = self.home / 'test.xauth'
        authority.write_bytes(b'synthetic authority\n')
        call = self.launch(env={'DISPLAY': ':4', 'OPD_DISPLAY': '',
                                'XAUTHORITY': str(authority)})
        self.assertFalse(any(item.split('=', 1)[0] in ('DISPLAY', 'XAUTHORITY')
                             for item in values(call, '-e', '--env')))
        self.assertNotIn(socket, mounts(call).values())
        self.assertNotIn('/tmp/.X11-unix', mounts(call))
        self.assertNotIn('/tmp/.docker.xauth', mounts(call))
        self.assertFalse(host_calls.exists())

    def test_help_never_calls_docker(self):
        result = self.invoke('--opd-help')
        self.assertEqual(result.returncode, 0)
        self.assertIn(b'--opd-', result.stdout + result.stderr)
        self.assertNotIn(b'--opd-web', result.stdout + result.stderr)
        self.assertNotIn(b'--opd-port', result.stdout + result.stderr)
        self.assertEqual(self.calls(), [])

    def test_unknown_web_port_arguments_forward_without_wrapper_effects(self):
        scenarios = [['--opd-web'], ['--opd-web=value'],
                     ['--opd-port', '8080'], ['--opd-port=8080']]
        for args in scenarios:
            for separator in ([], ['--']):
                with self.subTest(args=args, separator=separator):
                    self.reset_log()
                    call = self.launch(*separator, *args)
                    command = call.index('/usr/local/bin/omp')
                    self.assertEqual(call[command + 1:], args)
                    docker_options = call[:call.index('opd:latest')]
                    self.assertIn('--rm', docker_options)
                    self.assertEqual(values(docker_options, '--network'), ['host'])
                    self.assertFalse(any(
                        arg in ('-p', '-P', '--publish', '--publish-all') or
                        arg.startswith(('--publish=', '--publish-all=', '-p8080'))
                        for arg in docker_options), 'No port publication may be invented')

    def test_literal_arguments_after_separator(self):
        args = ['space argument', '', '$HOME', '$(touch should-not-exist)',
                '*.py', 'line\nbreak', 'quote\"single\'', '--opd-debug']
        call = self.launch('--', *args)
        image = call.index('opd:latest')
        self.assertEqual(Path(call[image + 1]).name, 'omp')
        self.assertEqual(call[image + 2:], args)
        self.assertFalse((self.cwd / 'should-not-exist').exists())
        self.assertIn('--rm', call, 'A literal --opd-debug must not change wrapper options')

    def test_image_mounts_security_and_non_tty(self):
        call = self.launch()
        command = call[call.index('opd:latest') + 1:]
        self.assertEqual(len(command), 1)
        self.assertEqual(Path(command[0]).name, 'omp')
        mounted = mounts(call)
        self.assertEqual(mounted.get('/home/coder'), self.repo / 'data')
        workdir = values(call, '-w', '--workdir')
        self.assertEqual(len(workdir), 1)
        self.assertRegex(workdir[0], r'^/workspaces/[A-Za-z0-9._-]+-[0-9a-f]{12}$')
        self.assertEqual(mounted.get(workdir[0]), self.cwd.resolve())
        self.assertEqual(values(call, '--network'), ['host'])
        self.assertIn('--init', call)
        self.assertEqual([v.lower() for v in values(call, '--shm-size')], ['1g'])
        security = values(call, '--security-opt')
        self.assertTrue(any(v in ('no-new-privileges', 'no-new-privileges:true',
                                  'no-new-privileges=true') for v in security))
        self.assertEqual([v.upper() for v in values(call, '--cap-drop')], ['ALL'])
        self.assert_graphics_security(call)
        self.assertEqual(values(call, '--device', '--gpus', '--group-add'), [])
        environment = values(call, '-e', '--env')
        self.assertIn('OPD_GPU=off', environment)
        self.assertFalse(any(item.startswith('NVIDIA_') for item in environment))
        self.assertEqual({v.upper() for v in values(call, '--cap-add')},
                         {'CHOWN', 'SETUID', 'SETGID'})
        self.assertTrue('-i' in call or '--interactive' in call)
        self.assertFalse(any(v in ('-t', '-it', '-ti', '--tty') or
                             v.startswith('--tty=') for v in call))

    def test_workdir_canonical_stable_and_distinct(self):
        first = self.launch()
        original = values(first, '-w', '--workdir')
        self.reset_log()
        alias = self.case / 'alias'
        alias.symlink_to(self.cwd, target_is_directory=True)
        second = self.launch(cwd=alias, env={'PWD': str(alias)})
        self.assertEqual(values(second, '-w', '--workdir'), original)
        self.reset_log()
        other = self.case / 'other' / self.cwd.name
        other.mkdir(parents=True)
        third = self.launch(cwd=other)
        self.assertNotEqual(values(third, '-w', '--workdir'), original)

    def test_debug_status_and_diagnostics(self):
        result = self.invoke('--opd-debug', env={'MOCK_DOCKER_STATUS': '37'})
        self.assertEqual(result.returncode, 37)
        self.assertEqual(result.stdout, b'')
        self.assertTrue(result.stderr, 'Debug diagnostics should go to stderr')
        call, _ = self.run_call()
        self.assertNotIn('--rm', call)
        self.assertNotIn('--opd-debug', call)

    def test_terminal_prompt_input_reaches_eof_without_user_input(self):
        scenarios = [
            (['--', '--print', 'Explain this project'], False),
            (['-p', 'prompt'], False),
            (['--mode=json', 'prompt'], False),
            (['--mode=rpc', '--mode=text', '--print', 'prompt'], False),
            (['prompt'], True),
        ]
        for args, redirect in scenarios:
            with self.subTest(args=args, redirect=redirect):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    *args, env={'MOCK_DOCKER_READ_STDIN': 'eof'},
                    redirect_stdout=redirect)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual((self.log / 'stdin').read_bytes(), b'')
                self.assertEqual(before, after)

    def test_real_piped_prompt_is_consumed_to_eof(self):
        prompt = b'Explain this project\nwith another line\n'
        result = subprocess.run(
            [str(self.repo / 'opd'), '--', '--print'], cwd=self.cwd,
            env={**self.env, 'MOCK_DOCKER_READ_STDIN': 'eof'}, input=prompt,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((self.log / 'stdin').read_bytes(), prompt)

    def test_terminal_protocol_and_subcommand_input_remains_live(self):
        for args in (['--mode=rpc'], ['--mode=acp'], ['acp'],
                     ['--print', '--mode=rpc'], ['login']):
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    *args, env={'MOCK_DOCKER_READ_STDIN': 'line'},
                    stdin_data=b'input frame\n')
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual((self.log / 'stdin').read_bytes(), b'input frame\n')
                self.assertEqual(before, after)

    def test_protocol_modes_suppress_tty_on_actual_terminal(self):
        scenarios = [[], ['acp'], ['--profile', 'work', 'acp'],
                     ['--model', 'model-name', 'acp'], ['--approval-mode=yolo', 'acp'],
                     ['--print', 'prompt'], ['-p', 'prompt'],
                     ['--mode', 'rpc'], ['--mode=rpc'],
                     ['--mode', 'json'], ['--mode=json'],
                     ['--mode', 'acp'], ['--mode=acp']]
        for args in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty(*args)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                call, _ = self.run_call()
                self.assertIn('-i', call)
                self.assertEqual('-t' in call, not args)
                self.assertEqual(before, after)
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)

    def test_final_mode_controls_tty_unless_print_or_acp(self):
        scenarios = [
            (['--mode=rpc', '--mode', 'text'], True),
            (['--mode', 'json', '--mode=text'], True),
            (['--mode=acp', '--mode', 'rpc-ui'], True),
            (['--mode', 'rpc', '--mode=json', '--mode', 'text'], True),
            (['--mode=text', '--mode', 'rpc'], False),
            (['--mode', 'rpc-ui', '--mode=json'], False),
            (['--mode=text', '--mode', 'acp'], False),
            (['--mode', 'text', '--mode=rpc', '--mode', 'json'], False),
            (['--print', '--mode=rpc', '--mode', 'text', 'prompt'], False),
            (['-p', '--mode=text', 'prompt'], False),
            (['acp', '--mode=rpc', '--mode', 'text'], False),
            (['--mode=rpc', 'acp', '--mode', 'text'], False),
            (['--mode=rpc', '--system-prompt', '--mode=text'], False),
            (['--mode=text', '--system-prompt', '--mode=rpc'], True),
            (['grep', '--mode=rpc', '--mode', 'text'], True),
            (['img', '--mode=text', '--mode', 'rpc'], True),
        ]
        for args, tty in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty('--', *args)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(before, after)
                call, _ = self.run_call()
                self.assertIn('-i', call)
                self.assertEqual('-t' in call, tty)
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)

    def test_stdout_and_docker_status_pass_through(self):
        payload = '{"response":"native output"}\nsecond line\n'
        for args in (['--print', 'prompt'], ['--mode', 'rpc'], ['acp']):
            with self.subTest(args=args):
                self.reset_log()
                result = self.invoke(*args, env={'MOCK_DOCKER_STDOUT': payload,
                                                'MOCK_DOCKER_STATUS': '37'})
                self.assertEqual(result.returncode, 37)
                self.assertEqual(result.stdout, payload.encode())
                self.run_call()

    def test_launch_diagnostics_do_not_expose_native_inputs_or_credentials(self):
        private = ['private-prompt-sentinel', 'private-system-sentinel',
                   'private-api-key-sentinel', 'private-provider-token-sentinel']
        for terminal in (False, True):
            with self.subTest(terminal=terminal):
                self.reset_log()
                args = ['--print', private[0], '--system-prompt', private[1],
                        '--api-key', private[2]]
                env = {'OPENAI_CODEX_OAUTH_TOKEN': private[3]}
                if terminal:
                    result, _, _ = self.invoke_tty(*args, env=env)
                else:
                    result = self.invoke(*args, env=env)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                for value in private:
                    self.assertNotIn(value.encode(), result.stderr)

    def test_no_banner_keeps_native_output_and_exit_status(self):
        for terminal in (False, True):
            with self.subTest(terminal=terminal):
                self.reset_log()
                env = {'OPD_NO_BANNER': '1', 'MOCK_DOCKER_STDOUT': 'native\n',
                       'MOCK_DOCKER_STATUS': '37'}
                if terminal:
                    result, _, _ = self.invoke_tty('--mode', 'rpc', env=env)
                else:
                    result = self.invoke('--mode', 'rpc', env=env)
                self.assertEqual(result.returncode, 37)
                self.assertEqual(result.stdout.replace(b'\r\n', b'\n'), b'native\n')
                self.assertEqual(result.stderr, b'')

    def test_interactive_banner_returns_after_app_clears_terminal(self):
        clear = '\x1b[2J\x1b[3J\x1b[H'
        for args, env, visible in (
                ([], {}, True),
                ([], {'OPD_NO_BANNER': '1'}, False),
                (['--mode', 'rpc'], {}, False),
                (['--model', 'example/model'], {}, False),
                (['--opd-profile', 'work'], {}, False),
                (['--'], {}, False)):
            with self.subTest(args=args, banner=visible):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    *args, terminal_stderr=True,
                    env={**env, 'MOCK_DOCKER_STDOUT': clear + 'app exited\n',
                         'MOCK_DOCKER_STATUS': '37'})
                self.assertEqual(result.returncode, 37)
                self.assertEqual(before, after)
                restored = result.stdout.split(clear.encode(), 1)[1]
                if visible:
                    self.assertIn(b'o-----o---o-----o', restored)
                    self.assertIn(b'Launch details:', restored)
                    self.assertIn(b'  Workspace:', restored)
                    self.assertIn(b'  Persistent home:', restored)
                    self.assertIn(b'  Network: host', restored)
                else:
                    self.assertNotIn(b'o-----o---o-----o', restored)
                    self.assertNotIn(b'Launch details:', restored)

    def test_signals_forward_status_and_restore_terminal(self):
        for number, status in ((signal.SIGINT, 130), (signal.SIGTERM, 143),
                               (signal.SIGHUP, 129)):
            with self.subTest(signal=number):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    env={'MOCK_DOCKER_WAIT': '1'}, send_signal=number)
                self.assertEqual(result.returncode, status, result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(before, after, 'Wrapper must restore modified terminal flags')
                self.assertIn(b'\x1b[?25h', result.stderr)
                self.assertTrue((self.log / 'signal').exists(), 'Docker never received signal')
                self.assertEqual((self.log / 'signal').read_text(), str(number))
                call, _ = self.run_call()
                self.assertIn('-t', call)

    def test_missing_image_fails_before_run_with_build_advice(self):
        result = self.invoke(env={'MOCK_DOCKER_IMAGE_STATUS': '43'})
        self.assertNotEqual(result.returncode, 0)
        self.assertEqual(result.stdout, b'')
        self.assertIn(b'build', result.stderr.lower(), 'Explain how to build the missing image')
        self.assertFalse(any(args[:1] == ['run'] for args, _ in self.calls()))

    def test_unavailable_daemon_fails_before_run_with_actionable_message(self):
        result = self.invoke(env={'MOCK_DOCKER_DAEMON_STATUS': '44'})
        self.assertNotEqual(result.returncode, 0)
        self.assertEqual(result.stdout, b'')
        message = result.stderr.lower()
        self.assertIn(b'docker', message)
        self.assertIn(b'daemon', message)
        self.assertTrue(any(word in message for word in (b'start', b'running', b'connect')),
                        'Explain how to resolve the unavailable daemon')
        self.assertFalse(any(args[:1] == ['run'] for args, _ in self.calls()))

    def test_base_config_seeded_once_default_and_named(self):
        base = self.repo / 'config' / 'config.yml'
        content = base.read_bytes()
        local = base.with_name('config.local.yml')
        local.write_text('task:\n  maxConcurrency: 9\n')
        for profile in (None, 'seeded-native'):
            with self.subTest(profile=profile):
                base.write_bytes(content)
                args = ['--opd-profile', profile] if profile else []
                self.reset_log()
                call = self.launch(*args, env={'PI_CONFIG_FILES': '/missing/host-overlay.yml'})
                config = self.seeded_config(profile)
                self.assertEqual(config.read_bytes(), content)
                self.assertFalse(any(item.split('=', 1)[0] == 'PI_CONFIG_FILES'
                                     for item in values(call, '-e', '--env')))
                customized = b'task:\n  maxConcurrency: 2\n'
                config.write_bytes(customized)
                changed_seed = b'task:\n  maxConcurrency: 7\n'
                base.write_bytes(changed_seed)
                self.reset_log()
                call = self.launch(*args)
                self.assertEqual(config.read_bytes(), customized)
                self.assertEqual(base.read_bytes(), changed_seed)
                self.assertFalse(any(item.split('=', 1)[0] == 'PI_CONFIG_FILES'
                                     for item in values(call, '-e', '--env')))

    def test_personality_is_first_launch_only_default_and_named(self):
        for profile in (None, 'personal'):
            with self.subTest(profile=profile):
                args = ['--opd-profile', profile] if profile else []
                self.reset_log()
                self.launch(*args)
                personality = self.agent(profile) / 'PERSONALITY.md'
                self.assertEqual(personality.stat().st_mode & 0o777, 0o600)
                personality.write_text('My own communication style.\n')
                self.reset_log()
                self.launch(*args)
                self.assertEqual(personality.read_text(), 'My own communication style.\n')
                personality.unlink()
                self.reset_log()
                self.launch(*args)
                self.assertFalse(personality.exists(), 'Do not reseed a removed personality')

    def test_personality_does_not_migrate_existing_profiles(self):
        for index, name in enumerate(('config.yml', 'config.yaml', 'settings.json')):
            with self.subTest(name=name):
                profile = f'existing-{index}'
                agent = self.agent(profile)
                agent.mkdir(parents=True)
                (agent / name).write_bytes(b'')
                self.reset_log()
                self.launch('--opd-profile', profile)
                self.assertFalse((agent / 'PERSONALITY.md').exists())

    def test_personality_preserves_empty_and_linked_overrides(self):
        for kind in ('empty', 'linked', 'dangling'):
            with self.subTest(kind=kind):
                agent = self.agent(kind)
                agent.mkdir(parents=True)
                personality = agent / 'PERSONALITY.md'
                target = self.case / f'{kind}-personality.md'
                if kind == 'empty':
                    personality.write_bytes(b'')
                else:
                    if kind == 'linked':
                        target.write_text('External personality.\n')
                    personality.symlink_to(target)
                self.reset_log()
                self.launch('--opd-profile', kind)
                if kind == 'empty':
                    self.assertEqual(personality.read_bytes(), b'')
                else:
                    self.assertTrue(personality.is_symlink())
                    if kind == 'linked':
                        self.assertEqual(target.read_text(), 'External personality.\n')
                    else:
                        self.assertFalse(target.exists())

    def test_wrapper_named_profile(self):
        call = self.launch('--opd-profile', 'work')
        self.seeded_config('work')
        self.assertNotIn('--opd-profile', call)
        self.assertFalse(self.agent().exists(), 'Named profile must not seed the default agent')

    def test_native_named_profile(self):
        call = self.launch('--profile', 'work')
        self.seeded_config('work')
        self.assertIn('--profile', call)
        profile_index = call.index('--profile')
        self.assertEqual(call[profile_index + 1], 'work')

    def test_environment_named_profile(self):
        self.launch(env={'OMP_PROFILE': 'environment'})
        self.seeded_config('environment')
        self.assertFalse(self.agent().exists())

    def test_last_native_profile_and_environment_precedence(self):
        scenarios = [
            (['--profile', 'first', '--profile=last'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env', 'OPD_PROFILE': 'fallback'}, 'last'),
            (['--profile=first', '--profile', 'last'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env'}, 'last'),
            ([], {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env', 'OPD_PROFILE': 'fallback'}, 'omp-env'),
            ([], {'PI_PROFILE': 'pi-env', 'OPD_PROFILE': 'fallback'}, 'fallback'),
            (['--opd-profile', 'wrapper'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env'}, 'wrapper'),
            (['--opd-profile', 'last', '--profile', 'first', '--profile=last'], {}, 'last'),
        ]
        for args, env, expected in scenarios:
            with self.subTest(args=args, env=env):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                call = self.launch(*args, env=env)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.assertNotIn('PI_PROFILE', assignments)
                self.seeded_config(expected)
                self.assertEqual(sorted((omp / 'profiles').iterdir()),
                                 [omp / 'profiles' / expected])

    def test_profile_normalization_and_defined_empty_precedence(self):
        scenarios = [
            ([], {'OMP_PROFILE': '', 'PI_PROFILE': 'legacy', 'OPD_PROFILE': 'fallback'}, 'default'),
            ([], {'OMP_PROFILE': ' \t\n', 'PI_PROFILE': 'legacy'}, 'default'),
            ([], {'PI_PROFILE': '', 'OPD_PROFILE': 'fallback'}, 'fallback'),
            ([], {'OPD_PROFILE': ''}, 'default'),
            ([], {'OMP_PROFILE': 'default', 'PI_PROFILE': 'legacy'}, 'default'),
            ([], {'OMP_PROFILE': ' \twork\r\n '}, 'work'),
            ([], {'PI_PROFILE': ' work '}, 'default'),
            ([], {'OPD_PROFILE': ' work '}, 'work'),
            (['--opd-profile', ''], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--opd-profile', ' \t '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--profile', ' \t '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--profile= default '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--opd-profile', ' work ', '--profile', '\twork\n'], {}, 'work'),
            (['--opd-profile', '', '--profile', 'default'], {}, 'default'),
            (['--profile', 'INVALID', '--profile=work'], {}, 'work'),
            (['--profile=first', '--profile', 'default'], {'OMP_PROFILE': 'environment'}, 'default'),
        ]
        for args, env, expected in scenarios:
            with self.subTest(args=args, env=env):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                call = self.launch(*args, env=env)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.assertNotIn('PI_PROFILE', assignments)
                self.seeded_config(None if expected == 'default' else expected)
                if expected == 'default':
                    self.assertFalse((omp / 'profiles').exists())

    def test_profile_scanner_respects_native_values_and_command_boundaries(self):
        scenarios = [
            (['--system-prompt', '--profile', 'foo'], 'default'),
            (['--print', '--system-prompt', '--profile', 'foo'], 'default'),
            # --goal protects even flag-looking values; native validates the
            # objective later. The mock only checks selection and forwarding.
            (['--goal', '--profile', 'work'], 'default'),
            (['--goal', '--profile=ignored', '--profile', 'work'], 'work'),
            (['--goal', 'objective', '--profile=work'], 'work'),
            (['--goal=--profile', '--profile=work'], 'work'),
            (['--goal', '', '--profile=work'], 'work'),
            (['--goal', 'grep', '--profile=work'], 'work'),
            (['--goal', '--', '--profile=work'], 'work'),
            (['--add-dir', '--profile', 'work'], 'default'),
            (['--prewalk-into', '--profile=ignored', '--profile=work'], 'work'),
            (['--plan-yolo-into', '--profile', 'work'], 'default'),
            (['--max-time', '--profile', 'work'], 'default'),
            (['--warn-cost', '--profile', 'work'], 'default'),
            (['--max-cost', '--profile=ignored', '--profile=work'], 'work'),
            (['--trusted-extension', '--profile', 'work'], 'default'),
            (['--no-title', '--profile=work'], 'work'),
            (['--config', '--profile=ignored', '--profile', 'work'], 'work'),
            (['--system-prompt=--profile', '--profile=work'], 'work'),
            (['--resume', '--profile', 'work'], 'work'),
            (['--session', '', '--profile=work'], 'work'),
            (['-r', 'session', '--profile', 'work'], 'work'),
            (['--plan', '--profile', 'work'], 'work'),
            (['--plan', 'model', '--profile=work'], 'work'),
            (['--custom-ext', 'value', '--profile=work'], 'work'),
            (['--custom-ext', '--profile=work'], 'work'),
            (['--print', '--profile=work'], 'work'),
            (['--alias', '--profile'], None),
            (['--alias', 'grep', '--profile=work'], 'work'),
            (['--alias=grep', '--profile=work'], 'work'),
            (['--profile=work', 'grep', '--profile', '../path'], 'work'),
            (['grep', '--profile', '../path'], 'default'),
            (['auth', '--profile', '../path'], 'default'),
            (['session', '--profile=../path'], 'default'),
            (['img', '--profile', '../path'], 'default'),
            (['anonymize', '--profile', '../path'], 'default'),
            (['plugins', '--profile=../path'], 'default'),
            (['wt', '--profile'], 'default'),
            (['launch', '--profile', 'first', '--profile=work'], 'work'),
            (['acp', '--profile', 'first', '--profile=work'], 'work'),
            (['--profile=first', 'acp', '--profile=work'], 'work'),
            # Bootstrap stops only at a FIRST residual command, not a later
            # command-looking prompt or a hoisted command behind launch flags.
            (['prompt', 'grep', '--profile=work'], 'work'),
            (['--no-ui', 'grep', '--profile=work'], 'work'),
            (['--profile=work', '--', '--profile', '../literal'], 'work'),
            (['--', '--profile', '../literal'], 'default'),
        ]
        for args, expected in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                if expected is None:
                    result = self.invoke('--', *args)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(self.calls(), [])
                    continue
                call = self.launch('--', *args)
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.seeded_config(None if expected == 'default' else expected)

    def test_machine_scanner_skips_native_values_and_command_owned_flags(self):
        scenarios = [
            ['--system-prompt', '--print', 'prompt'],
            ['--system-prompt', '--mode=rpc', 'prompt'],
            ['--goal', '--print', 'prompt'],
            ['--goal', '--mode=rpc', 'prompt'],
            ['--goal', 'acp'],
            ['--goal=--mode=rpc'],
            ['--add-dir', '--mode=rpc', 'prompt'],
            ['--prewalk-into', '--print', 'prompt'],
            ['--plan-yolo-into', '--mode=rpc', 'prompt'],
            ['--max-time', '--mode=rpc', 'prompt'],
            ['--warn-cost', '--print', 'prompt'],
            ['--max-cost', '--mode=rpc', 'prompt'],
            ['--wait-async', 'grep', '--mode=rpc'],
            ['--no-context-files', 'grep', '--mode=rpc'],
            ['--trusted-extension', 'acp'],
            ['--no-title', 'grep', '--mode=rpc'],
            ['--config', '-p', 'prompt'],
            ['--model', 'acp'],
            ['--custom-ext', 'acp'],
            ['prompt', 'acp'],
            ['--help', 'acp'],
            ['-h', 'acp'],
            ['--version', 'acp'],
            ['help', 'acp'],
            ['grep', '--print', '--mode=rpc'],
            ['img', '--mode', 'rpc'],
            ['anonymize', '--print', '--mode=rpc'],
            ['auth', '--print', '--mode=rpc'],
            ['session', '--mode', 'rpc'],
            # Resolver treats --plan as required-value, unlike bootstrap.
            ['--plan', '--unknown', 'anonymize', '--mode=rpc'],
            ['--no-ui', 'grep', '--mode=rpc'],
            ['--print', 'grep', '--profile', 'work'],
            ['--', '--print', '--mode=rpc', 'acp'],
        ]
        for args in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty('--', *args)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(before, after)
                call, _ = self.run_call()
                self.assertIn('-t', call, 'Value text and subcommand flags are not machine launch flags')
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)

    def test_native_profile_conflicts_use_native_or_reject_explicitly(self):
        scenarios = [
            (['--opd-profile', 'wrapper', '--profile', 'native'], {}),
            (['--profile', 'native', '--opd-profile', 'wrapper'], {}),
            (['--profile', 'native'], {'OMP_PROFILE': 'environment'}),
            (['--opd-profile', 'wrapper', '--profile', 'native'],
             {'OMP_PROFILE': 'environment'}),
        ]
        for args, env in scenarios:
            with self.subTest(args=args, env=env):
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                self.reset_log()
                result = self.invoke(*args, env=env)
                self.assertEqual(result.stdout, b'')
                if result.returncode:
                    self.assertIn(b'profile', result.stderr.lower(),
                                  'Conflicting profiles must be rejected explicitly')
                    self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
                    for profile in (None, 'native', 'wrapper', 'environment'):
                        self.assertFalse(self.agent(profile).exists(),
                                         'Rejected selection must not silently seed a profile')
                else:
                    call, _ = self.run_call()
                    self.seeded_config('native')
                    self.assertEqual(values(call, '--profile'), ['native'])
                    self.assertNotIn('--opd-profile', call)
                    for profile in (None, 'wrapper', 'environment'):
                        self.assertFalse(self.agent(profile).exists(),
                                         'Native profile must win over conflicting selectors')

    def test_wrapper_profile_overrides_environment_or_rejects(self):
        result = self.invoke('--opd-profile', 'wrapper', env={'OMP_PROFILE': 'environment'})
        self.assertEqual(result.stdout, b'')
        if result.returncode:
            self.assertIn(b'profile', result.stderr.lower())
            self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
            self.assertFalse(self.agent('wrapper').exists())
        else:
            self.run_call()
            self.seeded_config('wrapper')
        self.assertFalse(self.agent('environment').exists())
        self.assertFalse(self.agent().exists())

    def test_named_config_is_a_standalone_first_launch_seed(self):
        base = self.repo / 'config' / 'config.yml'
        named = self.repo / 'config' / 'profiles' / 'work.yml'
        base.write_text('task:\n  maxConcurrency: 4\n')
        named.write_text('browser:\n  enabled: false\n')
        self.launch('--opd-profile', 'work')
        saved = self.seeded_config('work')
        self.assertEqual(saved.read_bytes(), named.read_bytes(),
                         'A named seed is standalone, not merged with the base')
        customized = b'browser:\n  enabled: true\n'
        saved.write_bytes(customized)
        named.write_text('browser:\n  enabled: false\n')
        base.unlink()
        named.unlink()
        self.reset_log()
        call = self.launch('--opd-profile', 'work')
        self.assertEqual(saved.read_bytes(), customized,
                         'Saved native settings need no repository template on restart')
        self.assertFalse(any(item.split('=', 1)[0] == 'PI_CONFIG_FILES'
                             for item in values(call, '-e', '--env')))

    def test_new_profile_requires_a_readable_seed(self):
        (self.repo / 'config' / 'config.yml').unlink()
        result = self.invoke('--opd-profile', 'unseeded')
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'config template', result.stderr)
        self.assertEqual(result.stdout, b'')
        self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
        self.assertFalse((self.agent('unseeded') / 'config.yml').exists())

    def test_models_seed_preserves_existing_equivalents(self):
        template = self.repo / 'config' / 'models.yml'
        template.write_text('providers: {}\n')
        self.launch('--opd-profile', 'fresh-models')
        self.assertEqual((self.agent('fresh-models') / 'models.yml').read_bytes(),
                         template.read_bytes())
        for index, name in enumerate(('models.yml', 'models.yaml', 'models.json')):
            with self.subTest(name=name):
                profile = f'kept-models-{index}'
                agent = self.agent(profile)
                agent.mkdir(parents=True)
                existing = agent / name
                existing.write_bytes(b'')
                self.reset_log()
                self.launch('--opd-profile', profile)
                self.assertEqual(existing.read_bytes(), b'')
                self.assertEqual(sorted(path.name for path in agent.glob('models.*')), [name])

    def test_dangling_native_config_is_not_replaced(self):
        agent = self.agent('linked-file')
        agent.mkdir(parents=True)
        missing = self.case / 'missing-config.yml'
        existing = agent / 'config.yaml'
        existing.symlink_to(missing)
        self.launch('--opd-profile', 'linked-file')
        self.assertTrue(existing.is_symlink())
        self.assertFalse(missing.exists())
        self.assertFalse((agent / 'config.yml').exists())

    def test_existing_config_formats_are_preserved(self):
        (self.repo / 'config' / 'config.yml').unlink()
        for name in ('config.yml', 'config.yaml', 'settings.json'):
            with self.subTest(name=name):
                agent = self.agent('keep')
                if agent.exists():
                    shutil.rmtree(agent)
                agent.mkdir(parents=True)
                config = agent / name
                content = b''
                config.write_bytes(content)
                self.reset_log()
                self.launch('--opd-profile', 'keep')
                self.assertEqual(config.read_bytes(), content)
                self.assertEqual(sorted(p.name for p in agent.iterdir()
                                        if p.name in ('config.yml', 'config.yaml', 'settings.json')),
                                 [name], 'Do not seed a competing config over existing settings')

    def test_rejects_profile_traversal_before_docker(self):
        for flag in ('--profile', '--opd-profile'):
            for name in ('../escape', '/tmp/escape', 'nested/name', '..'):
                with self.subTest(flag=flag, name=name):
                    self.reset_log()
                    result = self.invoke(flag, name)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(self.calls(), [])
                    self.assertTrue(result.stderr)

    def test_valid_profile_names(self):
        for flag in ('--profile', '--opd-profile'):
            for name in ('work', 'work.v2', 'work_-2', '0', 'a' * 64):
                with self.subTest(flag=flag, name=name):
                    self.reset_log()
