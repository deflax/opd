    def test_rejects_non_native_profile_names_before_docker(self):
        invalid = ['_work', '-work', '.work', 'Work', 'work.', 'a' * 65,
                   'work space', 'work/other', 'con', 'con.txt', 'prn', 'prn.txt',
                   'aux', 'aux.txt', 'nul', 'nul.txt',
                   *[f'com{digit}' for digit in range(10)],
