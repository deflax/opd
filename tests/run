                    self.seeded_config(name)

    def test_rejects_non_native_profile_names_before_docker(self):
        invalid = ['_work', '-work', '.work', 'Work', 'work.', 'a' * 65,
                   'work space', 'work/other', 'con', 'con.txt', 'prn', 'prn.txt',
                   'aux', 'aux.txt', 'nul', 'nul.txt',
                   *[f'com{digit}' for digit in range(10)],
                   *[f'com{digit}.suffix' for digit in range(10)],
                   *[f'lpt{digit}' for digit in range(10)],
                   *[f'lpt{digit}.suffix' for digit in range(10)]]
        for name in invalid:
            for selector in ('--profile', '--opd-profile', 'OMP_PROFILE', 'OPD_PROFILE'):
                with self.subTest(name=name, selector=selector):
                    self.reset_log()
                    args = [selector, name] if selector.startswith('--') else []
                    env = {} if args else {selector: name}
                    result = self.invoke(*args, env=env)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'profile', result.stderr.lower())
                    self.assertEqual(result.stdout, b'')
                    self.assertEqual(self.calls(), [])

    def test_missing_or_empty_native_profile_values(self):
        for args in (['--profile'], ['--profile', ''], ['--profile='],
                     ['--profile', '--print']):
            with self.subTest(args=args):
                result = self.invoke(*args)
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'profile', result.stderr.lower())
                self.assertEqual(self.calls(), [])

    def test_allowlisted_env_forwarded_without_values(self):
        sentinels = {'ANTHROPIC_API_KEY': 'anthropic-secret-never-in-argv',
                     'OPENAI_API_KEY': 'openai-secret-never-in-argv',
                     'OPENAI_CODEX_OAUTH_TOKEN': 'codex-oauth-never-in-argv',
                     'UNRELATED_PRIVATE_TOKEN': 'unrelated-secret-never-forwarded'}
        call = self.launch(env=sentinels)
        forwarded = values(call, '-e', '--env')
        self.assertIn('ANTHROPIC_API_KEY', forwarded)
        self.assertIn('OPENAI_API_KEY', forwarded)
        self.assertIn('OPENAI_CODEX_OAUTH_TOKEN', forwarded)
        self.assertFalse(any(v.split('=', 1)[0] == 'UNRELATED_PRIVATE_TOKEN' for v in forwarded))
        self.assertFalse(any(secret in arg for secret in sentinels.values() for arg in call))
        _, record = self.run_call()
        for key, value in sentinels.items():
            self.assertEqual(record['env'].get(key), value)

    def test_symlinked_launcher_uses_real_repository(self):
        link = self.case / 'launcher-link'
        link.symlink_to(self.repo / 'opd')
        chained = self.case / 'launcher-chain'
        chained.symlink_to(link.name)
        call = self.launch(script=str(chained))
        self.assertEqual(mounts(call).get('/home/coder'), self.repo / 'data')
        self.assert_graphics_security(call)

    def test_symlinked_agent_state_refused_without_seeding_outside(self):
        for relative, profile in (('.omp', None), ('.omp/agent', None),
                                  ('.omp/run', None), ('.omp/run', 'work'),
                                  ('.omp/profiles', 'work'),
                                  ('.omp/profiles/work', 'work'),
                                  ('.omp/profiles/work/agent', 'work'),
                                  ('.omp/profiles/work/run', 'work')):
            with self.subTest(relative=relative, profile=profile):
                self.reset_log()
                data = self.repo / 'data'
                if data.exists():
                    shutil.rmtree(data)
                outside = self.case / ('outside-' + relative.replace('/', '-') + '-' + (profile or 'default'))
                outside.mkdir()
                sentinel = outside / 'sentinel'
                sentinel.write_bytes(b'outside state must survive\n')
                linked = data / relative
                linked.parent.mkdir(parents=True)
                linked.symlink_to(outside, target_is_directory=True)
                result = self.invoke(*(['--opd-profile', profile] if profile else []))
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'symlink', result.stderr.lower())
                self.assertEqual(result.stdout, b'')
                self.assertFalse(any(args[:1] == ['run'] for args, _ in self.calls()))
                self.assertEqual(list(outside.iterdir()), [sentinel])
                self.assertEqual(sentinel.read_bytes(), b'outside state must survive\n')

    def test_terminal_home_spellings_refuse_symlinks_without_seeding_or_cleanup(self):
        suffixes = ('', '/', '/.', '/./', '///', '/././', '///.//.///')
        for script, args in (('opd', []), ('clearcache', []),
                             ('clearcache', ['--dry-run'])):
            for index, suffix in enumerate(suffixes):
                with self.subTest(script=script, args=args, suffix=suffix):
                    self.reset_log()
                    outside = self.case / f'outside-{script}-{len(args)}-{index}'
                    sentinel = outside / '.cache' / 'sentinel'
                    sentinel.parent.mkdir(parents=True)
                    sentinel.write_bytes(b'external sentinel must survive\n')
                    linked = self.case / f'linked-{script}-{len(args)}-{index}'
                    linked.symlink_to(outside, target_is_directory=True)
                    result = self.invoke(*args, script=script,
                                         env={'OPD_DATA_DIR': str(linked) + suffix})
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'symlink', result.stderr.lower())
                    self.assertEqual(result.stdout, b'')
                    if script == 'opd':
                        self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
                    else:
                        self.assertEqual(self.calls(), [])
                    self.assertEqual(sentinel.read_bytes(), b'external sentinel must survive\n')
                    self.assertFalse((outside / '.omp').exists(),
                                     'Rejected home must not seed state through its link')
                    self.assertEqual(list(outside.iterdir()), [sentinel.parent])
                    self.assertEqual(list(sentinel.parent.iterdir()), [sentinel])

    def test_terminal_home_spellings_accept_real_directories(self):
        suffixes = ('', '/', '/.', '/./', '///', '/././', '///.//.///')
        for script in ('opd', 'clearcache'):
            for index, suffix in enumerate(suffixes):
                with self.subTest(script=script, suffix=suffix):
                    self.reset_log()
                    data = self.case / f'real-{script}-{index}'
                    data.mkdir()
                    sentinel = data / 'preserved'
                    sentinel.write_bytes(b'real home sentinel\n')
                    if script == 'clearcache':
                        disposable = data / '.cache' / 'disposable'
                        disposable.parent.mkdir()
                        disposable.write_bytes(b'disposable\n')
                    result = self.invoke(script=script,
                                         env={'OPD_DATA_DIR': str(data) + suffix})
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual(sentinel.read_bytes(), b'real home sentinel\n')
                    if script == 'opd':
                        self.assertEqual(result.stdout, b'')
                        call, _ = self.run_call()
                        self.assertEqual(mounts(call).get('/home/coder'), data.resolve())
                        self.assertTrue(any((data / '.omp' / 'agent' / name).is_file()
                                            for name in ('config.yml', 'config.yaml', 'settings.json')))
                    else:
                        self.assertFalse(disposable.exists())
                        self.assertEqual(self.calls(), [])

    def test_terminal_filesystem_root_spellings_remain_refused(self):
        for script in ('opd', 'clearcache'):
            for root in ('/', '//', '/.', '/./', '///.//.///'):
                with self.subTest(script=script, root=root):
                    self.reset_log()
                    result = self.invoke(script=script, env={'OPD_DATA_DIR': root})
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'refusing', result.stderr.lower())
                    self.assertEqual(result.stdout, b'')
                    if script == 'opd':
                        self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
                    else:
                        self.assertEqual(self.calls(), [])

    def test_build_host_identity_and_literal_args(self):
        result = self.invoke('--label', 'value with spaces;$HOME', script='build')
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        calls = [args for args, _ in self.calls() if args[:1] == ['build']]
        self.assertEqual(len(calls), 1)
        call = calls[0]
        self.assertIn('opd:latest', values(call, '-t', '--tag'))
        build_args = values(call, '--build-arg')
        uid, gid = (1000, 1000) if sys.platform == 'darwin' else (os.getuid(), os.getgid())
        self.assertIn('USER_UID=' + str(uid), build_args)
        self.assertIn('USER_GID=' + str(gid), build_args)
        self.assertEqual(values(call, '--label'), ['value with spaces;$HOME'])
        self.assertEqual(Path(call[-1]), self.repo)

    def test_build_macos_uses_container_identity(self):
        mocked_bin = self.case / 'darwin-bin'
        mocked_bin.mkdir()
        uname = mocked_bin / 'uname'
        uname.write_text('#!/bin/sh\nprintf "Darwin\\n"\n')
        uname.chmod(0o755)
        result = self.invoke(script='build',
                             env={'PATH': str(mocked_bin) + os.pathsep + self.env['PATH']})
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        calls = [args for args, _ in self.calls() if args[:1] == ['build']]
        self.assertEqual(len(calls), 1)
        self.assertIn('USER_UID=1000', values(calls[0], '--build-arg'))
        self.assertIn('USER_GID=1000', values(calls[0], '--build-arg'))

    def test_build_stops_when_missing_base_cannot_be_built(self):
        result = self.invoke(script='build', env={
            'MOCK_DOCKER_IMAGE_STATUS': '1',
            'MOCK_DOCKER_BUILD_STATUS': '23',
        })
        self.assertEqual(result.returncode, 23)
        builds = [args for args, _ in self.calls() if args[:1] == ['build']]
        self.assertEqual(len(builds), 1, 'Do not build omp after its base failed')

    def test_build_preserves_omp_build_failure_status(self):
        result = self.invoke(script='build',
                             env={'MOCK_DOCKER_BUILD_STATUS': '37'})
        self.assertEqual(result.returncode, 37)

    def test_clearcache_removes_cache_preserving_agents_and_external_symlinks(self):
        data = self.repo / 'data'
        protected = []
        for agent in (self.agent(), self.agent('work'), self.agent('personal')):
            for relative in ('agent.db', 'settings.json', 'config.yml', 'config.yaml',
                             'auth.json', 'sessions/retained.jsonl', 'sessions/deep/other.jsonl'):
                path = agent / relative
                path.parent.mkdir(parents=True, exist_ok=True)
                content = ('protected sentinel: ' + str(path.relative_to(data)) + '\n').encode()
                path.write_bytes(content)
                protected.append((path, content))
        cache = data / '.cache'
        disposable = cache / 'nested' / 'disposable-cache'
        disposable.parent.mkdir(parents=True)
        disposable.write_bytes(b'discard this cache\n')
        external = self.case / 'external-cache'
        external.mkdir()
        precious = external / 'precious-file'
        precious.write_bytes(b'external sentinel must survive\n')
        (cache / 'external-link').symlink_to(external, target_is_directory=True)
        result = self.invoke(script='clearcache')
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        self.assertFalse(disposable.exists(), 'Real cleanup must remove targeted cache contents')
        for path, content in protected:
            self.assertEqual(path.read_bytes(), content)
        self.assertEqual(precious.read_bytes(), b'external sentinel must survive\n')
        self.assertEqual(self.calls(), [])

        # A cache root itself may be an external symlink, not merely contain one.
        if cache.is_symlink():
            cache.unlink()
        elif cache.exists():
            shutil.rmtree(cache)
        cache.symlink_to(external, target_is_directory=True)
        result = self.invoke(script='clearcache')
        if result.returncode:
            self.assertIn(b'symlink', result.stderr.lower(),
                          'Safe refusal of a symlinked cache root must be explicit')
        self.assertEqual(precious.read_bytes(), b'external sentinel must survive\n')
        for path, content in protected:
            self.assertEqual(path.read_bytes(), content)
        self.assertEqual(self.calls(), [])

    def test_clearcache_dry_run_preserves_everything(self):
        data = self.repo / 'data'
        protected = [data / '.omp' / 'agent' / 'auth.json',
                     data / '.omp' / 'agent' / 'sessions' / 'session.jsonl',
                     data / '.cache' / 'disposable-cache',
                     self.case / 'external' / 'precious-file']
        for path in protected:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(b'keep-this-content\n')
        linked = data / '.cache' / 'external-link'
        linked.symlink_to(self.case / 'external', target_is_directory=True)
        result = self.invoke('--dry-run', script='clearcache')
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        for path in protected:
            self.assertEqual(path.read_bytes(), b'keep-this-content\n')
        self.assertTrue(linked.is_symlink())
        self.assertEqual(self.calls(), [])

    def test_clearcache_refuses_home_cache_and_filesystem_roots(self):
        outside = self.case / 'outside-cleanup'
        sentinel = outside / '.cache' / 'sentinel'
        sentinel.parent.mkdir(parents=True)
        sentinel.write_bytes(b'outside cache must survive\n')
        linked_home = self.case / 'linked-home'
        linked_home.symlink_to(outside, target_is_directory=True)
        data = self.repo / 'data'
        data.mkdir()
        (data / '.cache').symlink_to(outside / '.cache', target_is_directory=True)
        for root, message in ((str(linked_home), b'symlink'),
                              (str(data), b'symlink'), ('/', b'refusing')):
            with self.subTest(root=root):
                result = self.invoke(script='clearcache', env={'OPD_DATA_DIR': root})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(message, result.stderr.lower())
                self.assertEqual(sentinel.read_bytes(), b'outside cache must survive\n')
                self.assertEqual(self.calls(), [])


if __name__ == '__main__':
    unittest.main(verbosity=2)
