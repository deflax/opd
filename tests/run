#!/usr/bin/env python3
"""Hermetic behavioral checks; Docker is replaced with an argv/env recorder."""

import json
import os
from pathlib import Path
import pty
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import unittest


SOURCE = Path(__file__).resolve().parents[1]
MOCK = r'''#!/usr/bin/env python3
import json, os, pathlib, signal, sys, time, tty
root = pathlib.Path(os.environ['MOCK_DOCKER_LOG'])
root.mkdir(parents=True, exist_ok=True)
number = len(list(root.glob('*.args')))
stem = root / str(number)
stem.with_suffix('.args').write_bytes(b'\0'.join(os.fsencode(a) for a in sys.argv[1:]) + b'\0')
stem.with_suffix('.json').write_text(json.dumps({'env': dict(os.environ), 'cwd': os.getcwd()}))
args = sys.argv[1:]
daemon_status = int(os.environ.get('MOCK_DOCKER_DAEMON_STATUS', '0'))
image_status = int(os.environ.get('MOCK_DOCKER_IMAGE_STATUS', '0'))
if daemon_status:
    sys.stderr.write('Cannot connect to the Docker daemon; is it running?\n')
    sys.exit(daemon_status)
if image_status and (args[:2] == ['image', 'inspect'] or args[:1] == ['inspect']):
    sys.stderr.write('Error response from daemon: No such image: ompd:latest\n')
    sys.exit(image_status)
if args[:1] == ['run']:
    if 'MOCK_DOCKER_STDOUT' in os.environ:
        sys.stdout.write(os.environ['MOCK_DOCKER_STDOUT'])
        sys.stdout.flush()
    if 'MOCK_DOCKER_WAIT' in os.environ:
        def received(number, frame):
            (root / 'signal').write_text(str(number))
            sys.exit(128 + number)
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, received)
        if os.isatty(0):
            tty.setraw(0)
        (root / 'ready').write_text(str(os.getpid()))
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            time.sleep(0.01)
        sys.exit(98)
sys.exit(int(os.environ.get('MOCK_DOCKER_STATUS', '0')) if args[:1] == ['run'] else 0)
'''


def values(args, *names):
    """Accept equivalent long and short Docker option spellings."""
    result = []
    for index, arg in enumerate(args):
        if arg in names and index + 1 < len(args):
            result.append(args[index + 1])
        else:
            for name in names:
                if arg.startswith(name + '='):
                    result.append(arg[len(name) + 1:])
    return result


def mounts(args):
    result = {}
    for volume in values(args, '-v', '--volume'):
        parts = volume.split(':')
        if len(parts) >= 2:
            result[parts[1]] = Path(parts[0])
    for mount in values(args, '--mount'):
        fields = dict(part.split('=', 1) for part in mount.split(',') if '=' in part)
        source = fields.get('source', fields.get('src'))
        target = fields.get('target', fields.get('dst', fields.get('destination')))
        if source and target:
            result[target] = Path(source)
    return result


def tree_metadata(root):
    """Check real data stays untouched without reading credentials or following links."""
    if not root.exists() and not root.is_symlink():
        return None
    paths = [root]
    if root.is_dir() and not root.is_symlink():
        for directory, dirs, files in os.walk(root, followlinks=False):
            paths.extend(Path(directory) / name for name in dirs + files)
    result = {}
    for path in paths:
        stat = path.lstat()
        result[str(path.relative_to(root))] = (
            stat.st_mode, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns,
            os.readlink(path) if path.is_symlink() else None,
        )
    return result


class LauncherTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        # Copy the source once. Never execute against the real repository or HOME.
        cls.original_data = tree_metadata(SOURCE / 'data')
        preferred = Path('/tmp/opencode')
        temp_root = (str(preferred) if preferred.is_dir() and
                     os.access(preferred, os.W_OK | os.X_OK) else tempfile.gettempdir())
        cls.suite = tempfile.TemporaryDirectory(prefix='ompd-tests-', dir=temp_root)
        cls.root = Path(cls.suite.name)
        cls.snapshot = cls.root / 'snapshot'
        shutil.copytree(SOURCE, cls.snapshot,
                        ignore=shutil.ignore_patterns(
                            '.git', 'data', 'tests', '__pycache__', '*.local.*',
                            '.env', '.env.*', 'models.yml', 'models.yaml', 'mcp.json',
                            'key', '.key', 'keys', '.keys', '*.key', '*.pem',
                            'secrets', '.secrets', 'credentials', '.omp', '.pi',
                            '.ssh', '.gnupg', '.aws', '.azure'))
        cls.bin = cls.root / 'bin'
        cls.bin.mkdir()
        docker = cls.bin / 'docker'
        docker.write_text(MOCK)
        docker.chmod(0o755)

    @classmethod
    def tearDownClass(cls):
        try:
            if tree_metadata(SOURCE / 'data') != cls.original_data:
                raise AssertionError('Real repository data changed during the hermetic tests')
        finally:
            cls.suite.cleanup()

    def setUp(self):
        self.case = Path(tempfile.mkdtemp(prefix='case-', dir=self.root))
        self.repo = self.case / 'repo'
        shutil.copytree(self.snapshot, self.repo)
        self.home = self.case / 'host-home'
        self.home.mkdir()
        self.cwd = self.case / 'project space;$HOME'
        self.cwd.mkdir()
        self.log = self.case / 'docker-log'
        self.env = {
            'PATH': str(self.bin) + os.pathsep + os.defpath,
            'HOME': str(self.home), 'USER': 'test-user', 'LOGNAME': 'test-user',
            'LANG': 'C.UTF-8', 'TERM': 'dumb',
            'MOCK_DOCKER_LOG': str(self.log),
        }

    def invoke(self, *args, script='pi', cwd=None, env=None):
        path = self.repo / script
        self.assertTrue(path.is_file(), f'Missing required executable: {script}')
        self.assertTrue(os.access(path, os.X_OK), f'{script} must be executable')
        return subprocess.run([str(path), *args], cwd=cwd or self.cwd,
                              env={**self.env, **(env or {})}, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)

    def calls(self):
        if not self.log.exists():
            return []
        result = []
        for path in sorted(self.log.glob('*.args'), key=lambda p: int(p.stem)):
            args = [os.fsdecode(a) for a in path.read_bytes().split(b'\0')[:-1]]
            result.append((args, json.loads(path.with_suffix('.json').read_text())))
        return result

    def invoke_tty(self, *args, env=None, send_signal=None):
        """Use a real PTY, with bounded waits and isolated child cleanup."""
        master, slave = pty.openpty()
        process = None
        before = termios.tcgetattr(slave)
        try:
            process = subprocess.Popen(
                [str(self.repo / 'pi'), *args], cwd=self.cwd,
                env={**self.env, **(env or {})}, stdin=slave, stdout=slave,
                stderr=subprocess.PIPE, start_new_session=True)
            if send_signal is not None:
                deadline = time.monotonic() + 5
                while not (self.log / 'ready').exists():
                    if process.poll() is not None or time.monotonic() >= deadline:
                        self.fail('Mock Docker did not become ready for the signal test')
                    time.sleep(0.01)
                os.kill(process.pid, send_signal)
            _, stderr = process.communicate(timeout=10)
            after = termios.tcgetattr(slave)
            if send_signal is not None:
                # The wrapper may exit before its signalled child handles the
                # signal; allow that handler to record evidence before cleanup.
                deadline = time.monotonic() + 2
                while not (self.log / 'signal').exists() and time.monotonic() < deadline:
                    time.sleep(0.01)
            os.set_blocking(master, False)
            stdout = b''
            while True:
                try:
                    chunk = os.read(master, 65536)
                except BlockingIOError:
                    break
                if not chunk:
                    break
                stdout += chunk
            return subprocess.CompletedProcess(process.args, process.returncode,
                                               stdout, stderr), before, after
        finally:
            if process is not None:
                # Also reap a mock that outlives a signalled wrapper on failure.
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait(timeout=5)
            os.close(master)
            os.close(slave)

    def run_call(self):
        calls = [(args, record) for args, record in self.calls() if args[:1] == ['run']]
        self.assertEqual(len(calls), 1, 'Expected exactly one docker run')
        return calls[0]

    def reset_log(self):
        if self.log.exists():
            shutil.rmtree(self.log)

    def launch(self, *args, **kwargs):
        result = self.invoke(*args, **kwargs)
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        self.assertEqual(result.stdout, b'', 'Wrapper diagnostics must not pollute stdout')
        return self.run_call()[0]

    def agent(self, profile=None):
        omp = self.repo / 'data' / '.omp'
        return omp / ('profiles/' + profile + '/agent' if profile else 'agent')

    def seeded_config(self, profile=None):
        agent = self.agent(profile)
        candidates = [agent / name for name in ('config.yml', 'config.yaml', 'settings.json')]
        present = [path for path in candidates if path.is_file()]
        self.assertTrue(present, f'Profile was not seeded: {agent}')
        return present[0]

    def mock_display(self, platform):
        """Redirect only fixed host X11 paths in this case's isolated launcher."""
        mocked_bin = self.case / 'display-bin'
        mocked_bin.mkdir()
        uname = mocked_bin / 'uname'
        uname.write_text(f'#!/bin/sh\nprintf "{platform}\\n"\n')
        uname.chmod(0o755)
        host_calls = self.case / 'display-calls.jsonl'
        recorder = f'''#!/usr/bin/env python3
import json, os, pathlib, sys
with open({str(host_calls)!r}, 'a') as log:
    log.write(json.dumps({{'command': pathlib.Path(sys.argv[0]).name,
                          'args': sys.argv[1:], 'display': os.environ.get('DISPLAY')}}) + '\\n')
'''
        for name in ('open', 'xhost'):
            command = mocked_bin / name
            command.write_text(recorder)
            command.chmod(0o755)
        quartz = self.case / 'XQuartz.app'
        quartz.mkdir()
        socket = self.case / 'X11-unix'
        socket.mkdir()
        launcher = self.repo / 'pi'
        text = launcher.read_text()
        substitutions = [
            ('-d /Applications/Utilities/XQuartz.app', f'-d "{quartz}"', 1),
            ('-d /Applications/XQuartz.app', f'-d "{quartz}"', 1),
            ('/usr/bin/open -a XQuartz', f'"{mocked_bin / "open"}" -a XQuartz', 1),
            ('/opt/X11/bin/xhost', str(mocked_bin / 'xhost'), 2),
            ('-d /tmp/.X11-unix', f'-d "{socket}"', 1),
            ('source=/tmp/.X11-unix,', f'source={socket},', 1),
        ]
        for original, replacement, count in substitutions:
            self.assertEqual(text.count(original), count,
                             f'Expected fixed host-path substitution: {original}')
            text = text.replace(original, replacement)
        launcher.write_text(text)
        self.env['PATH'] = str(mocked_bin) + os.pathsep + self.env['PATH']
        return host_calls, socket

    def test_darwin_default_display_rewriting_and_xquartz_access(self):
        host_calls, _ = self.mock_display('Darwin')
        for display in (None, '', ':0', ':1', '/tmp/launchd-test/org.xquartz:0',
                        '/private/tmp/com.apple.launchd.test/org.xquartz:0',
                        '/var/run/com.apple.launchd.test/org.xquartz:0', 'remote.example:2'):
            with self.subTest(display=display):
                self.reset_log()
                if host_calls.exists():
                    host_calls.unlink()
                call = self.launch(env={} if display is None else {'DISPLAY': display})
                expected = 'remote.example:2' if display == 'remote.example:2' else 'host.docker.internal:0'
                self.assertIn('DISPLAY=' + expected, values(call, '-e', '--env'))
                calls = [json.loads(line) for line in host_calls.read_text().splitlines()]
                self.assertEqual(calls, [
                    {'command': 'open', 'args': ['-a', 'XQuartz'], 'display': display},
                    {'command': 'xhost', 'args': ['+127.0.0.1'], 'display': display or ':0'},
                    {'command': 'xhost', 'args': ['+localhost'], 'display': display or ':0'},
                ])
                self.assertNotIn('/tmp/.X11-unix', mounts(call))
                self.assertNotIn('/tmp/.docker.xauth', mounts(call))

    def test_darwin_explicit_display_passes_through_without_rewriting(self):
        host_calls, _ = self.mock_display('Darwin')
        for override in ('remote.example:7', ':3', '/tmp/explicit/org.xquartz:0'):
            with self.subTest(override=override):
                self.reset_log()
                host_calls.unlink(missing_ok=True)
                call = self.launch(env={'DISPLAY': ':9', 'OMPD_DISPLAY': override})
                self.assertIn('DISPLAY=' + override, values(call, '-e', '--env'))
                calls = [json.loads(line) for line in host_calls.read_text().splitlines()]
                self.assertEqual([entry['args'] for entry in calls],
                                 [['-a', 'XQuartz'], ['+127.0.0.1'], ['+localhost']])
                self.assertTrue(all(entry['display'] == ':9' for entry in calls))

    def test_darwin_empty_display_override_disables_all_host_actions(self):
        host_calls, socket = self.mock_display('Darwin')
        authority = self.home / 'test.xauth'
        authority.write_bytes(b'synthetic authority\n')
        call = self.launch(env={'DISPLAY': ':9', 'OMPD_DISPLAY': '',
                                'XAUTHORITY': str(authority)})
        self.assertFalse(host_calls.exists(), 'Disabled display must not open XQuartz or invoke xhost')
        self.assertFalse(any(item.split('=', 1)[0] in ('DISPLAY', 'XAUTHORITY')
                             for item in values(call, '-e', '--env')))
        self.assertNotIn(socket, mounts(call).values())
        self.assertNotIn('/tmp/.docker.xauth', mounts(call))

    def test_linux_display_mounts_socket_and_authority_readonly(self):
        host_calls, socket = self.mock_display('Linux')
        authority = self.home / 'test authority.xauth'
        authority.write_bytes(b'synthetic authority\n')
        for override in (None, 'remote.example:7'):
            with self.subTest(override=override):
                self.reset_log()
                env = {'DISPLAY': ':4', 'XAUTHORITY': str(authority)}
                if override is not None:
                    env['OMPD_DISPLAY'] = override
                call = self.launch(env=env)
                self.assertIn(f'type=bind,source={socket},target=/tmp/.X11-unix,readonly',
                              values(call, '--mount'))
                self.assertIn(f'type=bind,source={authority},target=/tmp/.docker.xauth,readonly',
                              values(call, '--mount'))
                self.assertIn('DISPLAY=' + (override or ':4'), values(call, '-e', '--env'))
                self.assertIn('XAUTHORITY=/tmp/.docker.xauth', values(call, '-e', '--env'))
                self.assertFalse(host_calls.exists())

    def test_linux_empty_display_override_adds_no_display_resources(self):
        host_calls, socket = self.mock_display('Linux')
        authority = self.home / 'test.xauth'
        authority.write_bytes(b'synthetic authority\n')
        call = self.launch(env={'DISPLAY': ':4', 'OMPD_DISPLAY': '',
                                'XAUTHORITY': str(authority)})
        self.assertFalse(any(item.split('=', 1)[0] in ('DISPLAY', 'XAUTHORITY')
                             for item in values(call, '-e', '--env')))
        self.assertNotIn(socket, mounts(call).values())
        self.assertNotIn('/tmp/.X11-unix', mounts(call))
        self.assertNotIn('/tmp/.docker.xauth', mounts(call))
        self.assertFalse(host_calls.exists())

    def test_help_never_calls_docker(self):
        result = self.invoke('--pi-help')
        self.assertEqual(result.returncode, 0)
        self.assertIn(b'--pi-', result.stdout + result.stderr)
        self.assertNotIn(b'--pi-web', result.stdout + result.stderr)
        self.assertNotIn(b'--pi-port', result.stdout + result.stderr)
        self.assertEqual(self.calls(), [])

    def test_unknown_web_port_arguments_forward_without_wrapper_effects(self):
        scenarios = [['--pi-web'], ['--pi-web=value'],
                     ['--pi-port', '8080'], ['--pi-port=8080']]
        for args in scenarios:
            for separator in ([], ['--']):
                with self.subTest(args=args, separator=separator):
                    self.reset_log()
                    call = self.launch(*separator, *args)
                    command = call.index('/usr/local/bin/omp')
                    self.assertEqual(call[command + 1:], args)
                    docker_options = call[:call.index('ompd:latest')]
                    self.assertIn('--rm', docker_options)
                    self.assertEqual(values(docker_options, '--network'), ['host'])
                    self.assertFalse(any(
                        arg in ('-p', '-P', '--publish', '--publish-all') or
                        arg.startswith(('--publish=', '--publish-all=', '-p8080'))
                        for arg in docker_options), 'No port publication may be invented')

    def test_literal_arguments_after_separator(self):
        args = ['space argument', '', '$HOME', '$(touch should-not-exist)',
                '*.py', 'line\nbreak', 'quote\"single\'', '--pi-debug']
        call = self.launch('--', *args)
        image = call.index('ompd:latest')
        self.assertEqual(Path(call[image + 1]).name, 'omp')
        self.assertEqual(call[image + 2:], args)
        self.assertFalse((self.cwd / 'should-not-exist').exists())
        self.assertIn('--rm', call, 'A literal --pi-debug must not change wrapper options')

    def test_image_mounts_security_and_non_tty(self):
        call = self.launch()
        command = call[call.index('ompd:latest') + 1:]
        self.assertEqual(len(command), 1)
        self.assertEqual(Path(command[0]).name, 'omp')
        mounted = mounts(call)
        self.assertEqual(mounted.get('/home/coder'), self.repo / 'data')
        workdir = values(call, '-w', '--workdir')
        self.assertEqual(len(workdir), 1)
        self.assertRegex(workdir[0], r'^/workspaces/[A-Za-z0-9._-]+-[0-9a-f]{12}$')
        self.assertEqual(mounted.get(workdir[0]), self.cwd.resolve())
        self.assertEqual(values(call, '--network'), ['host'])
        self.assertIn('--init', call)
        self.assertEqual([v.lower() for v in values(call, '--shm-size')], ['1g'])
        security = values(call, '--security-opt')
        self.assertTrue(any(v in ('no-new-privileges', 'no-new-privileges:true',
                                  'no-new-privileges=true') for v in security))
        self.assertEqual([v.upper() for v in values(call, '--cap-drop')], ['ALL'])
        self.assertEqual({v.upper() for v in values(call, '--cap-add')},
                         {'CHOWN', 'SETUID', 'SETGID'})
        self.assertTrue('-i' in call or '--interactive' in call)
        self.assertFalse(any(v in ('-t', '-it', '-ti', '--tty') or
                             v.startswith('--tty=') for v in call))

    def test_workdir_canonical_stable_and_distinct(self):
        first = self.launch()
        original = values(first, '-w', '--workdir')
        self.reset_log()
        alias = self.case / 'alias'
        alias.symlink_to(self.cwd, target_is_directory=True)
        second = self.launch(cwd=alias, env={'PWD': str(alias)})
        self.assertEqual(values(second, '-w', '--workdir'), original)
        self.reset_log()
        other = self.case / 'other' / self.cwd.name
        other.mkdir(parents=True)
        third = self.launch(cwd=other)
        self.assertNotEqual(values(third, '-w', '--workdir'), original)

    def test_debug_status_and_diagnostics(self):
        result = self.invoke('--pi-debug', env={'MOCK_DOCKER_STATUS': '37'})
        self.assertEqual(result.returncode, 37)
        self.assertEqual(result.stdout, b'')
        self.assertTrue(result.stderr, 'Debug diagnostics should go to stderr')
        call, _ = self.run_call()
        self.assertNotIn('--rm', call)
        self.assertNotIn('--pi-debug', call)

    def test_protocol_modes_suppress_tty_on_actual_terminal(self):
        scenarios = [[], ['acp'], ['--profile', 'work', 'acp'],
                     ['--model', 'model-name', 'acp'], ['--approval-mode=yolo', 'acp'],
                     ['--print', 'prompt'], ['-p', 'prompt'],
                     ['--mode', 'rpc'], ['--mode=rpc'],
                     ['--mode', 'json'], ['--mode=json'],
                     ['--mode', 'acp'], ['--mode=acp']]
        for args in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty(*args)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                call, _ = self.run_call()
                self.assertIn('-i', call)
                self.assertEqual('-t' in call, not args)
                self.assertEqual(before, after)
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)

    def test_stdout_and_docker_status_pass_through(self):
        payload = '{"response":"native output"}\nsecond line\n'
        for args in (['--print', 'prompt'], ['--mode', 'rpc'], ['acp']):
            with self.subTest(args=args):
                self.reset_log()
                result = self.invoke(*args, env={'MOCK_DOCKER_STDOUT': payload,
                                                'MOCK_DOCKER_STATUS': '37'})
                self.assertEqual(result.returncode, 37)
                self.assertEqual(result.stdout, payload.encode())
                self.run_call()

    def test_signals_forward_status_and_restore_terminal(self):
        for number, status in ((signal.SIGINT, 130), (signal.SIGTERM, 143),
                               (signal.SIGHUP, 129)):
            with self.subTest(signal=number):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    env={'MOCK_DOCKER_WAIT': '1'}, send_signal=number)
                self.assertEqual(result.returncode, status, result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(before, after, 'Wrapper must restore modified terminal flags')
                self.assertIn(b'\x1b[?25h', result.stderr)
                self.assertTrue((self.log / 'signal').exists(), 'Docker never received signal')
                self.assertEqual((self.log / 'signal').read_text(), str(number))
                call, _ = self.run_call()
                self.assertIn('-t', call)

    def test_missing_image_fails_before_run_with_build_advice(self):
        result = self.invoke(env={'MOCK_DOCKER_IMAGE_STATUS': '43'})
        self.assertNotEqual(result.returncode, 0)
        self.assertEqual(result.stdout, b'')
        self.assertIn(b'build', result.stderr.lower(), 'Explain how to build the missing image')
        self.assertFalse(any(args[:1] == ['run'] for args, _ in self.calls()))

    def test_unavailable_daemon_fails_before_run_with_actionable_message(self):
        result = self.invoke(env={'MOCK_DOCKER_DAEMON_STATUS': '44'})
        self.assertNotEqual(result.returncode, 0)
        self.assertEqual(result.stdout, b'')
        message = result.stderr.lower()
        self.assertIn(b'docker', message)
        self.assertIn(b'daemon', message)
        self.assertTrue(any(word in message for word in (b'start', b'running', b'connect')),
                        'Explain how to resolve the unavailable daemon')
        self.assertFalse(any(args[:1] == ['run'] for args, _ in self.calls()))

    def test_base_config_seeded_once_default_and_named(self):
        base = self.repo / 'config' / 'config.yml'
        content = base.read_bytes()
        # Check this small canonical YAML as text, not upstream runtime parsing.
        settings = [line for line in content.decode().splitlines()
                    if line.strip() and not line.lstrip().startswith('#')]
        expected_agents = {
            'scout': 'openai/gpt-6-luna',
            'reviewer': 'openai/gpt-6-astra',
            'security-reviewer': 'openai/gpt-6-astra',
            'task': 'openai/gpt-6.1-sol',
            'sonic': 'openai/gpt-6.1-sol',
        }
        self.assertEqual(settings, [
            'modelRoles:', '  default: openai/gpt-6.1-sol',
            'task:', '  maxConcurrency: 4', '  agentModelOverrides:',
            *[f'    {agent}: {model}' for agent, model in expected_agents.items()],
        ])
        for profile in (None, 'seeded-native'):
            with self.subTest(profile=profile):
                args = ['--pi-profile', profile] if profile else []
                self.reset_log()
                call = self.launch(*args)
                config = self.seeded_config(profile)
                self.assertEqual(config.read_bytes(), content)
                self.assertIn('PI_CONFIG_FILES=/config/ompd/config.yml',
                              values(call, '-e', '--env'))
                self.assertEqual(mounts(call).get('/config/ompd'), base.parent)
                customized = b'task:\n  maxConcurrency: 2\n'
                config.write_bytes(customized)
                self.reset_log()
                call = self.launch(*args)
                self.assertEqual(config.read_bytes(), customized)
                self.assertEqual(base.read_bytes(), content)
                self.assertIn('PI_CONFIG_FILES=/config/ompd/config.yml',
                              values(call, '-e', '--env'))

    def test_wrapper_named_profile(self):
        call = self.launch('--pi-profile', 'work')
        self.seeded_config('work')
        self.assertNotIn('--pi-profile', call)
        self.assertFalse(self.agent().exists(), 'Named profile must not seed the default agent')

    def test_native_named_profile(self):
        call = self.launch('--profile', 'work')
        self.seeded_config('work')
        self.assertIn('--profile', call)
        profile_index = call.index('--profile')
        self.assertEqual(call[profile_index + 1], 'work')

    def test_environment_named_profile(self):
        self.launch(env={'PI_PROFILE': 'environment'})
        self.seeded_config('environment')
        self.assertFalse(self.agent().exists())

    def test_last_native_profile_and_environment_precedence(self):
        scenarios = [
            (['--profile', 'first', '--profile=last'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env', 'OMPD_PROFILE': 'fallback'}, 'last'),
            (['--profile=first', '--profile', 'last'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env'}, 'last'),
            ([], {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env', 'OMPD_PROFILE': 'fallback'}, 'omp-env'),
            ([], {'PI_PROFILE': 'pi-env', 'OMPD_PROFILE': 'fallback'}, 'pi-env'),
            ([], {'OMPD_PROFILE': 'fallback'}, 'fallback'),
            (['--pi-profile', 'wrapper'],
             {'OMP_PROFILE': 'omp-env', 'PI_PROFILE': 'pi-env'}, 'wrapper'),
            (['--pi-profile', 'last', '--profile', 'first', '--profile=last'], {}, 'last'),
        ]
        for args, env, expected in scenarios:
            with self.subTest(args=args, env=env):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                call = self.launch(*args, env=env)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.assertEqual(assignments['PI_PROFILE'], expected)
                self.seeded_config(expected)
                self.assertEqual(sorted((omp / 'profiles').iterdir()),
                                 [omp / 'profiles' / expected])

    def test_profile_normalization_and_defined_empty_precedence(self):
        scenarios = [
            ([], {'OMP_PROFILE': '', 'PI_PROFILE': 'legacy', 'OMPD_PROFILE': 'fallback'}, 'default'),
            ([], {'OMP_PROFILE': ' \t\n', 'PI_PROFILE': 'legacy'}, 'default'),
            ([], {'PI_PROFILE': '', 'OMPD_PROFILE': 'fallback'}, 'default'),
            ([], {'OMPD_PROFILE': ''}, 'default'),
            ([], {'OMP_PROFILE': 'default', 'PI_PROFILE': 'legacy'}, 'default'),
            ([], {'OMP_PROFILE': ' \twork\r\n '}, 'work'),
            ([], {'PI_PROFILE': ' work '}, 'work'),
            ([], {'OMPD_PROFILE': ' work '}, 'work'),
            (['--pi-profile', ''], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--pi-profile', ' \t '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--profile', ' \t '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--profile= default '], {'OMP_PROFILE': 'environment'}, 'default'),
            (['--pi-profile', ' work ', '--profile', '\twork\n'], {}, 'work'),
            (['--pi-profile', '', '--profile', 'default'], {}, 'default'),
            (['--profile', 'INVALID', '--profile=work'], {}, 'work'),
            (['--profile=first', '--profile', 'default'], {'OMP_PROFILE': 'environment'}, 'default'),
        ]
        for args, env, expected in scenarios:
            with self.subTest(args=args, env=env):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                call = self.launch(*args, env=env)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.assertEqual(assignments['PI_PROFILE'], expected)
                self.seeded_config(None if expected == 'default' else expected)
                if expected == 'default':
                    self.assertFalse((omp / 'profiles').exists())

    def test_profile_scanner_respects_native_values_and_command_boundaries(self):
        scenarios = [
            (['--system-prompt', '--profile', 'foo'], 'default'),
            (['--print', '--system-prompt', '--profile', 'foo'], 'default'),
            (['--config', '--profile=ignored', '--profile', 'work'], 'work'),
            (['--system-prompt=--profile', '--profile=work'], 'work'),
            (['--resume', '--profile', 'work'], 'work'),
            (['--session', '', '--profile=work'], 'work'),
            (['-r', 'session', '--profile', 'work'], 'work'),
            (['--plan', '--profile', 'work'], 'work'),
            (['--plan', 'model', '--profile=work'], 'work'),
            (['--custom-ext', 'value', '--profile=work'], 'work'),
            (['--custom-ext', '--profile=work'], 'work'),
            (['--print', '--profile=work'], 'work'),
            (['--alias', '--profile'], None),
            (['--alias', 'grep', '--profile=work'], 'work'),
            (['--alias=grep', '--profile=work'], 'work'),
            (['--profile=work', 'grep', '--profile', '../path'], 'work'),
            (['grep', '--profile', '../path'], 'default'),
            (['img', '--profile', '../path'], 'default'),
            (['plugins', '--profile=../path'], 'default'),
            (['wt', '--profile'], 'default'),
            (['launch', '--profile', 'first', '--profile=work'], 'work'),
            (['acp', '--profile', 'first', '--profile=work'], 'work'),
            (['--profile=first', 'acp', '--profile=work'], 'work'),
            # Bootstrap stops only at a FIRST residual command, not a later
            # command-looking prompt or a hoisted command behind launch flags.
            (['prompt', 'grep', '--profile=work'], 'work'),
            (['--no-ui', 'grep', '--profile=work'], 'work'),
            (['--profile=work', '--', '--profile', '../literal'], 'work'),
            (['--', '--profile', '../literal'], 'default'),
        ]
        for args, expected in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                if expected is None:
                    result = self.invoke('--', *args)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(self.calls(), [])
                    continue
                call = self.launch('--', *args)
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)
                assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                                   if '=' in item)
                self.assertEqual(assignments['OMP_PROFILE'], expected)
                self.seeded_config(None if expected == 'default' else expected)

    def test_machine_scanner_skips_native_values_and_command_owned_flags(self):
        scenarios = [
            ['--system-prompt', '--print', 'prompt'],
            ['--system-prompt', '--mode=rpc', 'prompt'],
            ['--config', '-p', 'prompt'],
            ['--model', 'acp'],
            ['--custom-ext', 'acp'],
            ['prompt', 'acp'],
            ['--help', 'acp'],
            ['-h', 'acp'],
            ['--version', 'acp'],
            ['help', 'acp'],
            ['grep', '--print', '--mode=rpc'],
            ['img', '--mode', 'rpc'],
            ['--no-ui', 'grep', '--mode=rpc'],
            ['--print', 'grep', '--profile', 'work'],
            ['--', '--print', '--mode=rpc', 'acp'],
        ]
        for args in scenarios:
            with self.subTest(args=args):
                self.reset_log()
                result, before, after = self.invoke_tty('--', *args)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(before, after)
                call, _ = self.run_call()
                self.assertIn('-t', call, 'Value text and subcommand flags are not machine launch flags')
                self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:], args)

    def test_native_profile_conflicts_use_native_or_reject_explicitly(self):
        scenarios = [
            (['--pi-profile', 'wrapper', '--profile', 'native'], {}),
            (['--profile', 'native', '--pi-profile', 'wrapper'], {}),
            (['--profile', 'native'], {'PI_PROFILE': 'environment'}),
            (['--pi-profile', 'wrapper', '--profile', 'native'],
             {'PI_PROFILE': 'environment'}),
        ]
        for args, env in scenarios:
            with self.subTest(args=args, env=env):
                omp = self.repo / 'data' / '.omp'
                if omp.exists():
                    shutil.rmtree(omp)
                self.reset_log()
                result = self.invoke(*args, env=env)
                self.assertEqual(result.stdout, b'')
                if result.returncode:
                    self.assertIn(b'profile', result.stderr.lower(),
                                  'Conflicting profiles must be rejected explicitly')
                    self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
                    for profile in (None, 'native', 'wrapper', 'environment'):
                        self.assertFalse(self.agent(profile).exists(),
                                         'Rejected selection must not silently seed a profile')
                else:
                    call, _ = self.run_call()
                    self.seeded_config('native')
                    self.assertEqual(values(call, '--profile'), ['native'])
                    self.assertNotIn('--pi-profile', call)
                    for profile in (None, 'wrapper', 'environment'):
                        self.assertFalse(self.agent(profile).exists(),
                                         'Native profile must win over conflicting selectors')

    def test_wrapper_profile_overrides_environment_or_rejects(self):
        result = self.invoke('--pi-profile', 'wrapper', env={'PI_PROFILE': 'environment'})
        self.assertEqual(result.stdout, b'')
        if result.returncode:
            self.assertIn(b'profile', result.stderr.lower())
            self.assertFalse(any(call[:1] == ['run'] for call, _ in self.calls()))
            self.assertFalse(self.agent('wrapper').exists())
        else:
            self.run_call()
            self.seeded_config('wrapper')
        self.assertFalse(self.agent('environment').exists())
        self.assertFalse(self.agent().exists())

    def test_local_then_profile_config_overlays(self):
        config = self.repo / 'config'
        profiles = config / 'profiles'
        profiles.mkdir(parents=True, exist_ok=True)
        local = config / 'config.local.yml'
        named = profiles / 'overlaid.yml'
        local.write_text('test_local_overlay: true\n')
        named.write_text('test_named_overlay: true\n')
        call = self.launch('--pi-profile', 'overlaid')
        base = config / 'config.yml'
        self.assertEqual(self.seeded_config('overlaid').read_bytes(), base.read_bytes())
        _, record = self.run_call()
        env_args = values(call, '-e', '--env')
        assignments = dict(item.split('=', 1) for item in env_args if '=' in item)
        files = assignments.get('PI_CONFIG_FILES')
        if files is None and 'PI_CONFIG_FILES' in env_args:
            files = record['env'].get('PI_CONFIG_FILES')
        self.assertTrue(files, 'Overlays must use native PI_CONFIG_FILES')
        # Accept common native path-list separators without coupling to mount names.
        import re
        paths = [part.strip() for part in re.split(r'[,;:]', files) if part.strip()]
        mounted = mounts(call)
        resolved = []
        for path in paths:
            for target in sorted(mounted, key=len, reverse=True):
                if path == target or path.startswith(target.rstrip('/') + '/'):
                    resolved.append(mounted[target] / path[len(target):].lstrip('/'))
                    break
            else:
                self.fail(f'Config overlay is not available through a bind mount: {path}')
        self.assertEqual(resolved, [base, local, named],
                         'Pass base, local, then named profile overlays to native omp')
        for path in resolved:
            self.assertTrue(path.is_file(), f'Missing overlay: {path}')

    def test_ollama_overlay_maps_all_bundled_agents_and_is_forwarded(self):
        profile = self.repo / 'config' / 'profiles' / 'ollama.yml'
        settings = [line for line in profile.read_text().splitlines()
                    if line.strip() and not line.lstrip().startswith('#')]
        agents = ('scout', 'reviewer', 'security-reviewer', 'task', 'sonic')
        self.assertEqual(settings, [
            'modelRoles:', '  default: ollama/gemma4:26b-16k',
            'task:', '  agentModelOverrides:',
            *[f'    {agent}: ollama/gemma4:26b-16k' for agent in agents],
        ])
        # Mock launch checks overlay delivery and literal --model forwarding,
        # not native model availability or runtime model resolution.
        call = self.launch('--pi-profile', 'ollama', '--model', 'example/main')
        assignments = dict(item.split('=', 1) for item in values(call, '-e', '--env')
                           if '=' in item)
        self.assertEqual(assignments['PI_CONFIG_FILES'].split(':'),
                         ['/config/ompd/config.yml', '/config/ompd/profiles/ollama.yml'])
        self.assertEqual(mounts(call).get('/config/ompd'), profile.parent.parent)
        base = self.repo / 'config' / 'config.yml'
        self.assertEqual(self.seeded_config('ollama').read_bytes(), base.read_bytes())
        self.assertEqual(call[call.index('/usr/local/bin/omp') + 1:],
                         ['--model', 'example/main'])

    def test_existing_config_formats_are_preserved(self):
        for name in ('config.yml', 'config.yaml', 'settings.json'):
            with self.subTest(name=name):
                agent = self.agent('keep')
                if agent.exists():
                    shutil.rmtree(agent)
                agent.mkdir(parents=True)
                config = agent / name
                content = b'{"test_sentinel": "preserve-me"}\n'
                config.write_bytes(content)
                self.reset_log()
                self.launch('--pi-profile', 'keep')
                self.assertEqual(config.read_bytes(), content)
                self.assertEqual(sorted(p.name for p in agent.iterdir()
                                        if p.name in ('config.yml', 'config.yaml', 'settings.json')),
                                 [name], 'Do not seed a competing config over existing settings')

