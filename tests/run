#!/usr/bin/env python3
"""Hermetic behavioral checks; Docker is replaced with an argv/env recorder."""

import json
import os
from pathlib import Path
import pty
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import unittest


SOURCE = Path(__file__).resolve().parents[1]
MOCK = r'''#!/usr/bin/env python3
import json, os, pathlib, signal, sys, time, tty
root = pathlib.Path(os.environ['MOCK_DOCKER_LOG'])
root.mkdir(parents=True, exist_ok=True)
number = len(list(root.glob('*.args')))
stem = root / str(number)
stem.with_suffix('.args').write_bytes(b'\0'.join(os.fsencode(a) for a in sys.argv[1:]) + b'\0')
stem.with_suffix('.json').write_text(json.dumps({'env': dict(os.environ), 'cwd': os.getcwd()}))
args = sys.argv[1:]
daemon_status = int(os.environ.get('MOCK_DOCKER_DAEMON_STATUS', '0'))
image_status = int(os.environ.get('MOCK_DOCKER_IMAGE_STATUS', '0'))
if daemon_status:
    sys.stderr.write('Cannot connect to the Docker daemon; is it running?\n')
    sys.exit(daemon_status)
if image_status and (args[:2] == ['image', 'inspect'] or args[:1] == ['inspect']):
    sys.stderr.write('Error response from daemon: No such image: opd:latest\n')
    sys.exit(image_status)
if args[:1] == ['build']:
    sys.exit(int(os.environ.get('MOCK_DOCKER_BUILD_STATUS', '0')))
if args[:1] == ['run']:
    if 'MOCK_DOCKER_READ_STDIN' in os.environ:
        data = (sys.stdin.buffer.readline() if os.environ['MOCK_DOCKER_READ_STDIN'] == 'line'
                else sys.stdin.buffer.read())
        (root / 'stdin').write_bytes(data)
    if 'MOCK_DOCKER_STDOUT' in os.environ:
        sys.stdout.write(os.environ['MOCK_DOCKER_STDOUT'])
        sys.stdout.flush()
    if 'MOCK_DOCKER_STDERR' in os.environ:
        sys.stderr.write(os.environ['MOCK_DOCKER_STDERR'])
        sys.stderr.flush()
    if 'MOCK_DOCKER_WAIT' in os.environ:
        def received(number, frame):
            (root / 'signal').write_text(str(number))
            sys.exit(128 + number)
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, received)
        if os.isatty(0):
            tty.setraw(0)
        (root / 'ready').write_text(str(os.getpid()))
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            time.sleep(0.01)
        sys.exit(98)
sys.exit(int(os.environ.get('MOCK_DOCKER_STATUS', '0')) if args[:1] == ['run'] else 0)
'''


def values(args, *names):
    """Accept equivalent long and short Docker option spellings."""
    result = []
    for index, arg in enumerate(args):
        if arg in names and index + 1 < len(args):
            result.append(args[index + 1])
        else:
            for name in names:
                if arg.startswith(name + '='):
                    result.append(arg[len(name) + 1:])
    return result


def mounts(args):
    result = {}
    for volume in values(args, '-v', '--volume'):
        parts = volume.split(':')
        if len(parts) >= 2:
            result[parts[1]] = Path(parts[0])
    for mount in values(args, '--mount'):
        fields = dict(part.split('=', 1) for part in mount.split(',') if '=' in part)
        source = fields.get('source', fields.get('src'))
        target = fields.get('target', fields.get('dst', fields.get('destination')))
        if source and target:
            result[target] = Path(source)
    return result


def tree_metadata(root):
    """Check real data stays untouched without reading credentials or following links."""
    if not root.exists() and not root.is_symlink():
        return None
    paths = [root]
    if root.is_dir() and not root.is_symlink():
        for directory, dirs, files in os.walk(root, followlinks=False):
            paths.extend(Path(directory) / name for name in dirs + files)
    result = {}
    for path in paths:
        stat = path.lstat()
        result[str(path.relative_to(root))] = (
            stat.st_mode, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns,
            os.readlink(path) if path.is_symlink() else None,
        )
    return result


class LauncherTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        # Copy the source once. Never execute against the real repository or HOME.
        cls.original_data = tree_metadata(SOURCE / 'data')
        preferred = Path('/tmp/opencode')
        temp_root = (str(preferred) if preferred.is_dir() and
                     os.access(preferred, os.W_OK | os.X_OK) else tempfile.gettempdir())
        cls.suite = tempfile.TemporaryDirectory(prefix='opd-tests-', dir=temp_root)
        cls.root = Path(cls.suite.name)
        cls.snapshot = cls.root / 'snapshot'
        shutil.copytree(SOURCE, cls.snapshot,
                        ignore=shutil.ignore_patterns(
                            '.git', 'data', 'tests', '__pycache__', '*.local.*',
                            '.env', '.env.*', 'models.yml', 'models.yaml', 'mcp.json',
                            'key', '.key', 'keys', '.keys', '*.key', '*.pem',
                            'secrets', '.secrets', 'credentials', '.omp', '.pi',
                            '.ssh', '.gnupg', '.aws', '.azure'))
        cls.bin = cls.root / 'bin'
        cls.bin.mkdir()
        docker = cls.bin / 'docker'
        docker.write_text(MOCK)
        docker.chmod(0o755)

    @classmethod
    def tearDownClass(cls):
        try:
            if tree_metadata(SOURCE / 'data') != cls.original_data:
                raise AssertionError('Real repository data changed during the hermetic tests')
        finally:
            cls.suite.cleanup()

    def setUp(self):
        self.case = Path(tempfile.mkdtemp(prefix='case-', dir=self.root))
        self.repo = self.case / 'repo'
        shutil.copytree(self.snapshot, self.repo)
        self.home = self.case / 'host-home'
        self.home.mkdir()
        self.cwd = self.case / 'project space;$HOME'
        self.cwd.mkdir()
        self.log = self.case / 'docker-log'
        self.env = {
            'PATH': str(self.bin) + os.pathsep + os.defpath,
            'HOME': str(self.home), 'USER': 'test-user', 'LOGNAME': 'test-user',
            'LANG': 'C.UTF-8', 'TERM': 'dumb',
            'MOCK_DOCKER_LOG': str(self.log),
        }

    def invoke(self, *args, script='opd', cwd=None, env=None):
        path = self.repo / script
        self.assertTrue(path.is_file(), f'Missing required executable: {script}')
        self.assertTrue(os.access(path, os.X_OK), f'{script} must be executable')
        return subprocess.run([str(path), *args], cwd=cwd or self.cwd,
                              env={**self.env, **(env or {})}, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)

    def calls(self):
        if not self.log.exists():
            return []
        result = []
        for path in sorted(self.log.glob('*.args'), key=lambda p: int(p.stem)):
            args = [os.fsdecode(a) for a in path.read_bytes().split(b'\0')[:-1]]
            result.append((args, json.loads(path.with_suffix('.json').read_text())))
        return result

    def invoke_tty(self, *args, env=None, send_signal=None, stdin_data=None,
                   redirect_stdout=False, terminal_stderr=False):
        """Use a real PTY, with bounded waits and isolated child cleanup."""
        master, slave = pty.openpty()
        process = None
        before = termios.tcgetattr(slave)
        if stdin_data is not None:
            os.write(master, stdin_data)
        try:
            process = subprocess.Popen(
                [str(self.repo / 'opd'), *args], cwd=self.cwd,
                env={**self.env, **(env or {})}, stdin=slave,
                stdout=subprocess.PIPE if redirect_stdout else slave,
                stderr=slave if terminal_stderr else subprocess.PIPE,
                start_new_session=True)
            if send_signal is not None:
                deadline = time.monotonic() + 5
                while not (self.log / 'ready').exists():
                    if process.poll() is not None or time.monotonic() >= deadline:
                        self.fail('Mock Docker did not become ready for the signal test')
                    time.sleep(0.01)
                os.kill(process.pid, send_signal)
            captured_stdout, stderr = process.communicate(timeout=10)
            after = termios.tcgetattr(slave)
            if send_signal is not None:
                # The wrapper may exit before its signalled child handles the
                # signal; allow that handler to record evidence before cleanup.
                deadline = time.monotonic() + 2
                while not (self.log / 'signal').exists() and time.monotonic() < deadline:
                    time.sleep(0.01)
            os.set_blocking(master, False)
            stdout = captured_stdout or b''
            while True:
                try:
                    chunk = os.read(master, 65536)
                except BlockingIOError:
                    break
                if not chunk:
                    break
                stdout += chunk
            return subprocess.CompletedProcess(process.args, process.returncode,
                                               stdout, stderr), before, after
        finally:
            if process is not None:
                # Also reap a mock that outlives a signalled wrapper on failure.
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait(timeout=5)
            os.close(master)
            os.close(slave)

    def run_call(self):
        calls = [(args, record) for args, record in self.calls() if args[:1] == ['run']]
        self.assertEqual(len(calls), 1, 'Expected exactly one docker run')
        # Every launch path, including profiles, debug and TTY modes, must keep
        # the mandatory policy. Native arguments are not Docker options.
        args = calls[0][0]
        self.assert_graphics_security(args[:args.index('/usr/local/bin/omp')])
        return calls[0]

    def reset_log(self):
        if self.log.exists():
            shutil.rmtree(self.log)

    def launch(self, *args, **kwargs):
        result = self.invoke(*args, **kwargs)
        self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
        self.assertEqual(result.stdout, b'', 'Wrapper diagnostics must not pollute stdout')
        return self.run_call()[0]

    def agent(self, profile=None):
        omp = self.repo / 'data' / '.omp'
        return omp / ('profiles/' + profile + '/agent' if profile else 'agent')

    def seeded_config(self, profile=None):
        agent = self.agent(profile)
        candidates = [agent / name for name in ('config.yml', 'config.yaml', 'settings.json')]
        present = [path for path in candidates if path.is_file()]
        self.assertTrue(present, f'Profile was not seeded: {agent}')
        return present[0]

    def mock_display(self, platform):
        """Redirect only fixed host X11 paths in this case's isolated launcher."""
        mocked_bin = self.case / 'display-bin'
        mocked_bin.mkdir()
        uname = mocked_bin / 'uname'
        uname.write_text(f'#!/bin/sh\nprintf "{platform}\\n"\n')
        uname.chmod(0o755)
        host_calls = self.case / 'display-calls.jsonl'
        recorder = f'''#!/usr/bin/env python3
import json, os, pathlib, sys
with open({str(host_calls)!r}, 'a') as log:
    log.write(json.dumps({{'command': pathlib.Path(sys.argv[0]).name,
                          'args': sys.argv[1:], 'display': os.environ.get('DISPLAY')}}) + '\\n')
'''
        for name in ('open', 'xhost'):
            command = mocked_bin / name
            command.write_text(recorder)
            command.chmod(0o755)
        quartz = self.case / 'XQuartz.app'
        quartz.mkdir()
        socket = self.case / 'X11-unix'
        socket.mkdir()
        launcher = self.repo / 'opd'
        text = launcher.read_text()
        substitutions = [
            ('-d /Applications/Utilities/XQuartz.app', f'-d "{quartz}"', 1),
            ('-d /Applications/XQuartz.app', f'-d "{quartz}"', 1),
            ('/usr/bin/open -g -a XQuartz', f'"{mocked_bin / "open"}" -g -a XQuartz', 1),
            ('/opt/X11/bin/xhost', str(mocked_bin / 'xhost'), 2),
            ('-d /tmp/.X11-unix', f'-d "{socket}"', 1),
            ('source=/tmp/.X11-unix,', f'source={socket},', 1),
        ]
        for original, replacement, count in substitutions:
            self.assertEqual(text.count(original), count,
                             f'Expected fixed host-path substitution: {original}')
            text = text.replace(original, replacement)
        launcher.write_text(text)
        self.env['PATH'] = str(mocked_bin) + os.pathsep + self.env['PATH']
        return host_calls, socket

    def graphics_devices(self):
        """Redirect device and PCI metadata paths without touching real host devices."""
        devices = self.case / 'dri'
        devices.mkdir()
        launcher = self.repo / 'opd'
        text = launcher.read_text()
        self.assertIn('/dev/dri/', text, 'Device fixture must isolate host render nodes')
        text = text.replace('/dev/dri/', str(devices) + '/')
        text = text.replace('/sys/class/drm/', str(self.case / 'sysfs') + '/')
        launcher.write_text(text)
        return devices

    def graphics_pci_device(self, name, address):
        target = self.case / 'pci' / address
        target.mkdir(parents=True, exist_ok=True)
        node = self.case / 'sysfs' / name
        node.mkdir(parents=True)
        (node / 'device').symlink_to(target, target_is_directory=True)

    def assert_graphics_security(self, call):
        self.assertEqual(values(call, '--security-opt'), [
            'no-new-privileges:true',
            f'seccomp={self.repo.resolve() / "browser-seccomp.json"}',
        ])
        self.assertEqual(values(call, '--cap-drop'), ['ALL'])
        self.assertEqual(set(values(call, '--cap-add')), {'CHOWN', 'SETUID', 'SETGID'})
        self.assertNotIn('--privileged', call)
        self.assertNotIn('--runtime', call)
        self.assertFalse(any(path == '/dev' or path.startswith('/dev/')
                             for path in mounts(call)))
        self.assertEqual(values(call, '--user'), ['coder'])

    def test_invalid_seccomp_profile_fails_before_docker_state_and_display(self):
        host_calls, _ = self.mock_display('Darwin')
        policy = self.repo / 'browser-seccomp.json'
        policy.unlink()
        for existing_home in (False, True):
            data = self.repo / 'data'
            if existing_home:
                data.mkdir()
                (data / 'sentinel').write_text('existing state must stay untouched\n')
            before = tree_metadata(data)
            for layout in ('missing', 'directory', 'broken-link'):
                with self.subTest(existing_home=existing_home, layout=layout):
                    if layout == 'directory':
                        policy.mkdir()
                    elif layout == 'broken-link':
                        policy.symlink_to(self.case / 'missing-policy.json')
                    result = self.invoke()
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(result.stdout, b'')
                    self.assertIn(b'required browser seccomp policy', result.stderr)
                    self.assertIn(os.fsencode(policy), result.stderr)
                    self.assertEqual(tree_metadata(data), before)
                    self.assertFalse(host_calls.exists())
                    self.assertEqual(self.calls(), [])
                    if layout == 'directory':
                        policy.rmdir()
                    elif layout == 'broken-link':
                        policy.unlink()

    def test_unreadable_seccomp_profile_fails_before_docker_state_and_display(self):
        host_calls, _ = self.mock_display('Darwin')
        credentials = {}
        if os.geteuid() == 0:
            # Root bypasses mode bits. Drop privileges only in the child; make
            # our private fixtures traversable without changing host directories.
            if any(not directory.stat().st_mode & 0o001
                   for directory in self.root.parents):
                self.skipTest('Temporary directory ancestors are not world-traversable')
            self.root.chmod(0o755)
            self.case.chmod(0o755)
            credentials = {'user': 65534, 'group': 65534, 'extra_groups': []}
        policy = self.repo / 'browser-seccomp.json'
        mode = policy.stat().st_mode & 0o777
        policy.chmod(0)
        try:
            result = subprocess.run(
                [str(self.repo / 'opd')], cwd=self.cwd, env=self.env,
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, timeout=15, **credentials)
            self.assertNotEqual(result.returncode, 0)
            self.assertEqual(result.stdout, b'')
            self.assertIn(b'required browser seccomp policy', result.stderr)
            self.assertIn(os.fsencode(policy), result.stderr)
            self.assertFalse((self.repo / 'data').exists())
            self.assertFalse(host_calls.exists())
            self.assertEqual(self.calls(), [])
        finally:
            policy.chmod(mode)

    def test_seccomp_docker_failure_surfaces_without_retry(self):
        failure = 'failed to load seccomp profile\n'
        result = self.invoke(env={'MOCK_DOCKER_STATUS': '125',
                                  'MOCK_DOCKER_STDERR': failure})
        self.assertEqual(result.returncode, 125)
        self.assertEqual(result.stdout, b'')
        self.assertIn(failure.encode(), result.stderr)
        call, _ = self.run_call()
        self.assert_graphics_security(call)

    def test_invalid_graphics_selections_fail_before_state_and_display(self):
        host_calls, _ = self.mock_display('Darwin')
        for value in ('', 'OFF', 'Software', 'auto', ' off', 'off ', 'off\n',
                      'software --privileged'):
            with self.subTest(value=value):
                result = self.invoke(env={'OPD_GPU': value})
                self.assertNotEqual(result.returncode, 0)
                self.assertEqual(result.stdout, b'')
                self.assertIn(b'OPD_GPU', result.stderr)
                self.assertFalse((self.repo / 'data').exists())
                self.assertFalse(host_calls.exists())
                self.assertEqual(self.calls(), [])

    def test_hardware_modes_reject_non_linux_before_state_and_display(self):
        host_calls, _ = self.mock_display('Darwin')
        for mode in ('nvidia', 'dri'):
            with self.subTest(mode=mode):
                result = self.invoke(env={'OPD_GPU': mode})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'requires a Linux host', result.stderr)
                self.assertFalse((self.repo / 'data').exists())
                self.assertFalse(host_calls.exists())
                self.assertEqual(self.calls(), [])

    def test_portable_modes_keep_device_isolation_and_sandbox_security(self):
        self.mock_display('Darwin')
        for mode in ('off', 'software'):
            with self.subTest(mode=mode):
                self.reset_log()
                result = self.invoke(env={
                    'OPD_GPU': mode,
                    'OPD_ACCEPT_GPU_RISK': '1',
                    'NVIDIA_VISIBLE_DEVICES': 'all',
                    'NVIDIA_DRIVER_CAPABILITIES': 'all',
                    'OPD_DOCKER_ARGS': '--privileged --device /dev',
                })
                self.assertEqual(result.returncode, 0, result.stderr)
                call, _ = self.run_call()
                self.assert_graphics_security(call)
                self.assertEqual(values(call, '--device', '--gpus', '--group-add'), [])
                environment = values(call, '-e', '--env')
                self.assertIn('OPD_GPU=' + mode, environment)
                self.assertFalse(any(item.startswith(('NVIDIA_', 'OPD_DOCKER_ARGS'))
                                     for item in environment))
                self.seeded_config()

    def test_nvidia_requests_graphics_without_weakening_security(self):
        self.mock_display('Linux')
        result = self.invoke(env={
            'OPD_GPU': 'nvidia',
            'NVIDIA_DRIVER_CAPABILITIES': 'all', 'NVIDIA_VISIBLE_DEVICES': 'none',
        })
        self.assertEqual(result.returncode, 0, result.stderr)
        call, _ = self.run_call()
        self.assert_graphics_security(call)
        self.assertEqual(values(call, '--device'), ['nvidia.com/gpu=all'])
        self.assertEqual(values(call, '--gpus', '--group-add'), [])
        environment = values(call, '-e', '--env')
        self.assertFalse(any(item.startswith('NVIDIA_') for item in environment))
        self.assertIn('OPD_GPU=nvidia', environment)
        self.seeded_config()

    def test_nvidia_toolkit_failure_surfaces_without_software_retry(self):
        self.mock_display('Linux')
        failure = 'unresolvable CDI devices nvidia.com/gpu=all\n'
        result = self.invoke(env={'OPD_GPU': 'nvidia', 'MOCK_DOCKER_STATUS': '125',
                                  'MOCK_DOCKER_STDERR': failure})
        self.assertEqual(result.returncode, 125)
        self.assertEqual(result.stdout, b'')
        self.assertIn(failure.encode(), result.stderr)
        call, _ = self.run_call()
        self.assertEqual(values(call, '--device'), ['nvidia.com/gpu=all'])
        self.assertEqual(values(call, '--gpus'), [])
        self.assertIn('OPD_GPU=nvidia', values(call, '-e', '--env'))
        self.assert_graphics_security(call)

    def test_dri_requires_character_render_nodes_before_state_and_display(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        for layout in ('missing', 'empty', 'regular-file', 'directory'):
            with self.subTest(layout=layout):
                if layout == 'missing':
                    devices.rmdir()
                elif layout == 'empty':
                    devices.mkdir()
                elif layout == 'regular-file':
                    (devices / 'renderD128').write_text('not a device')
                else:
                    (devices / 'renderD128').unlink()
                    (devices / 'renderD128').mkdir()
                result = self.invoke(env={'OPD_GPU': 'dri'})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'character device', result.stderr)
                self.assertFalse((self.repo / 'data').exists())
                self.assertFalse(host_calls.exists())
                self.assertEqual(self.calls(), [])

    @unittest.skipUnless(sys.platform.startswith('linux'), 'Linux stat and device fixtures')
    def test_dri_exposes_only_render_characters_and_deduplicates_numeric_groups(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        for name in ('renderD128', 'renderD129'):
            (devices / name).symlink_to('/dev/null')
        (devices / 'card0').symlink_to('/dev/null')
        (devices / 'renderD130').write_text('not a device')
        (devices / 'renderD131').mkdir()
        (devices / 'renderD132').symlink_to(devices / 'missing')
        call = self.launch(env={'OPD_GPU': 'dri', 'OPD_ACCEPT_GPU_RISK': '1',
                                'DRI_PRIME': 'untrusted-host-selection'})
        self.assert_graphics_security(call)
        self.assertEqual(values(call, '--device'),
                         [f'{devices / name}:{devices / name}:rw'
                          for name in ('renderD128', 'renderD129')])
        self.assertEqual(values(call, '--group-add'), [str(os.stat('/dev/null').st_gid)])
        self.assertEqual(values(call, '--gpus'), [])
        self.assertIn('OPD_GPU=dri', values(call, '-e', '--env'))
        self.assertFalse(any(item.startswith('DRI_PRIME') for item in values(call, '-e', '--env')))
        self.seeded_config()

    def test_dri_group_lookup_fails_closed_before_state(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        stat = self.case / 'display-bin' / 'stat'
        for body in ('exit 1', 'printf "not-a-gid\\n"'):
            with self.subTest(body=body):
                stat.write_text('#!/bin/sh\n' + body + '\n')
                stat.chmod(0o755)
                result = self.invoke(env={'OPD_GPU': 'dri'})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'group', result.stderr)
                self.assertFalse((self.repo / 'data').exists())
                self.assertEqual(self.calls(), [])

    def test_dri_selector_mounts_only_selected_node_and_routes_its_pci_gpu(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        addresses = {'renderD128': '0000:12:00.0', 'renderD129': '0001:02:0a.3'}
        for name, address in addresses.items():
            (devices / name).symlink_to('/dev/null')
            self.graphics_pci_device(name, address)
        for name, address in addresses.items():
            with self.subTest(name=name):
                self.reset_log()
                selected = devices / name
                call = self.launch(env={
                    'OPD_GPU': 'dri', 'OPD_DRI_DEVICE': str(selected),
                    'OPD_ACCEPT_GPU_RISK': '1', 'DRI_PRIME': 'wrong-host-selection'})
                self.assertEqual(values(call, '--device'), [f'{selected}:{selected}:rw'])
                self.assertEqual(values(call, '--group-add'), [str(os.stat(selected).st_gid)])
                environment = values(call, '-e', '--env')
                self.assertIn('DRI_PRIME=pci-' + address.replace(':', '_').replace('.', '_'),
                              environment)
                self.assertFalse(any(item.startswith('OPD_DRI_DEVICE') for item in environment))
                self.assert_graphics_security(call)

    def test_dri_selector_rejects_other_modes_before_docker_state_and_display(self):
        host_calls, _ = self.mock_display('Linux')
        for mode in ('off', 'software', 'nvidia'):
            for selection in ('', '/dev/dri/renderD128'):
                with self.subTest(mode=mode, selection=selection):
                    result = self.invoke(env={'OPD_GPU': mode, 'OPD_DRI_DEVICE': selection})
                    self.assertNotEqual(result.returncode, 0)
                    self.assertIn(b'OPD_DRI_DEVICE requires OPD_GPU=dri', result.stderr)
                    self.assertEqual(result.stdout, b'')
                    self.assertEqual(self.calls(), [])
                    self.assertFalse((self.repo / 'data').exists())
                    self.assertFalse(host_calls.exists())

    def test_dri_selector_rejects_invalid_paths_before_docker_state_and_display(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        selections = ('', 'renderD128', '/dev/null', str(devices / 'card0'),
                      str(devices / 'renderD'), str(devices / 'renderD128/other'),
                      str(devices / 'renderD128;private-value'),
                      str(devices / 'renderD128\n'))
        for selection in selections:
            with self.subTest(selection=selection):
                result = self.invoke(env={'OPD_GPU': 'dri', 'OPD_DRI_DEVICE': selection})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'OPD_DRI_DEVICE must name', result.stderr)
                self.assertNotIn(b'private-value', result.stderr)
                self.assertEqual(result.stdout, b'')
                self.assertEqual(self.calls(), [])
                self.assertFalse((self.repo / 'data').exists())
                self.assertFalse(host_calls.exists())

    def test_dri_selector_never_falls_back_to_another_available_node(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        selected = devices / 'renderD129'
        for kind in ('missing', 'regular-file', 'directory', 'broken-link'):
            with self.subTest(kind=kind):
                if kind == 'regular-file':
                    selected.write_text('not a device')
                elif kind == 'directory':
                    selected.mkdir()
                elif kind == 'broken-link':
                    selected.symlink_to(devices / 'missing')
                result = self.invoke(env={
                    'OPD_GPU': 'dri', 'OPD_DRI_DEVICE': str(selected),
                    'OPD_ACCEPT_GPU_RISK': '1'})
                self.assertNotEqual(result.returncode, 0)
                self.assertIn(b'existing character render device', result.stderr)
                self.assertEqual(self.calls(), [])
                self.assertFalse((self.repo / 'data').exists())
                self.assertFalse(host_calls.exists())
                if selected.is_dir():
                    selected.rmdir()
                elif selected.exists() or selected.is_symlink():
                    selected.unlink()

    def test_dri_selector_requires_a_resolvable_pci_mapping(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        selected = devices / 'renderD128'
        selected.symlink_to('/dev/null')
        env = {'OPD_GPU': 'dri', 'OPD_DRI_DEVICE': str(selected),
               'OPD_ACCEPT_GPU_RISK': '1'}
        result = self.invoke(env=env)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'PCI device mapping', result.stderr)
        self.graphics_pci_device('renderD128', 'not-a-pci-device')
        result = self.invoke(env=env)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'resolve to a PCI GPU', result.stderr)
        self.assertEqual(self.calls(), [])
        self.assertFalse((self.repo / 'data').exists())
        self.assertFalse(host_calls.exists())

    def test_dri_selector_still_requires_gpu_risk_acceptance(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        selected = devices / 'renderD128'
        selected.symlink_to('/dev/null')
        self.graphics_pci_device('renderD128', '0000:12:00.0')
        result = self.invoke(env={'OPD_GPU': 'dri', 'OPD_DRI_DEVICE': str(selected)})
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'GPU risk not accepted', result.stderr)
        self.assertEqual(self.calls(), [])
        self.assertFalse((self.repo / 'data').exists())
        self.assertFalse(host_calls.exists())

    def test_gpu_risk_refusal_precedes_docker_state_and_display(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        for mode in ('software', 'dri'):
            for acceptance in (None, '', '0', 'yes', 'true'):
                with self.subTest(mode=mode, acceptance=acceptance):
                    env = {'OPD_GPU': mode, 'OPD_NO_BANNER': '1'}
                    if acceptance is not None:
                        env['OPD_ACCEPT_GPU_RISK'] = acceptance
                    result = self.invoke('private-native-argument', env=env)
                    self.assertNotEqual(result.returncode, 0)
                    self.assertEqual(result.stdout, b'')
                    self.assertIn(b'GPU risk not accepted', result.stderr)
                    self.assertNotIn(b'private-native-argument', result.stderr)
                    self.assertFalse((self.repo / 'data').exists())
                    self.assertFalse(host_calls.exists())
                    self.assertEqual(self.calls(), [])

    def test_gpu_risk_acceptance_preserves_protocol_input_output_and_status(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        frame = b'{"id":1,"method":"probe"}\n'
        response = b'{"id":1,"result":"ok"}\n'
        for mode in ('software', 'dri'):
            with self.subTest(mode=mode):
                self.reset_log()
                result = subprocess.run(
                    [str(self.repo / 'opd'), '--mode=rpc'], cwd=self.cwd,
                    env={**self.env, 'OPD_GPU': mode, 'OPD_ACCEPT_GPU_RISK': '1',
                         'OPD_NO_BANNER': '1', 'MOCK_DOCKER_READ_STDIN': 'eof',
                         'MOCK_DOCKER_STDOUT': response.decode(),
                         'MOCK_DOCKER_STATUS': '37'},
                    input=frame, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    timeout=10)
                self.assertEqual(result.returncode, 37, result.stderr)
                self.assertEqual(result.stdout, response)
                self.assertEqual((self.log / 'stdin').read_bytes(), frame)
                self.assertIn(b'WARNING:', result.stderr)
                call, _ = self.run_call()
                self.assertFalse(any(item.startswith('OPD_ACCEPT_GPU_RISK')
                                     for item in values(call, '-e', '--env')))
                self.reset_log()
                refused = self.invoke(env={'OPD_GPU': mode})
                self.assertNotEqual(refused.returncode, 0)
                self.assertIn(b'GPU risk not accepted', refused.stderr)
                self.assertEqual(self.calls(), [], 'Acceptance must not persist across launches')

    def test_gpu_risk_interactive_acceptance_leaves_native_input_intact(self):
        self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        for mode in ('software', 'dri'):
            with self.subTest(mode=mode):
                self.reset_log()
                result, before, after = self.invoke_tty(
                    env={'OPD_GPU': mode, 'MOCK_DOCKER_READ_STDIN': 'line'},
                    stdin_data=b'ACCEPT\nnative input\n', terminal_stderr=True)
                self.assertEqual(result.returncode, 0, result.stdout)
                self.assertEqual((self.log / 'stdin').read_bytes(), b'native input\n')
                self.assertEqual(before, after)
                self.run_call()

    def test_gpu_risk_interactive_rejection_and_eof_cancel_without_state(self):
        host_calls, _ = self.mock_display('Linux')
        devices = self.graphics_devices()
        (devices / 'renderD128').symlink_to('/dev/null')
        for mode in ('software', 'dri'):
