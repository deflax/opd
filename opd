#!/usr/bin/env bash
set -euo pipefail

die() { printf 'opd: %s\n' "$*" >&2; exit 1; }

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}" count=0
    while [[ -L "$source" ]]; do
        count=$((count + 1))
        [[ $count -le 40 ]] || die 'script symlink loop'
        SCRIPT_DIR="$(CDPATH= cd -P -- "$(dirname -- "$source")" && pwd)"
        source="$(readlink -- "$source")"
        [[ "$source" == /* ]] || source="$SCRIPT_DIR/$source"
    done
    SCRIPT_DIR="$(CDPATH= cd -P -- "$(dirname -- "$source")" && pwd)"
}

usage() {
    cat <<'EOF'
Usage: opd [wrapper options] [omp arguments]

  --opd-help           Show wrapper help (native help: opd -- --help)
  --opd-debug          Keep the container and print inspection/removal commands
  --opd-profile NAME   Select native profile state and its first-launch config seed
  --                  Stop wrapper parsing; forward remaining arguments literally

Native arguments are preserved as an array. Explicit native --profile wins over
environment defaults; conflicting explicit wrapper/native profiles are rejected.
Last native --profile wins. Names are 1-64 lowercase letters/digits, dots,
underscores or hyphens, starting with a letter/digit; no trailing dot or reserved
Windows device names. Empty/whitespace/default selects default. Defined
OMP_PROFILE, even when empty, takes precedence over OPD_PROFILE.

Environment: OPD_IMAGE (opd:latest), OPD_DATA_DIR (repo/data; absolute),
OPD_PROFILE (default), OMP_PROFILE (native selection),
OPD_DISPLAY (override DISPLAY), OPD_NO_BANNER (suppress logo and launch details).
EOF
}

normalize_profile() {
    # oh-my-pi v18.9.1 packages/utils/src/dirs.ts normalizeProfileName.
    # POSIX/Bash whitespace trimming, not JavaScript's full Unicode trim set.
    local value="$1" LC_ALL=C
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    NORMALIZED_PROFILE="${value:-default}"
    [[ "$NORMALIZED_PROFILE" != default ]] || return 0
    [[ "$value" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ && "$value" != *. &&
       ! "$value" =~ ^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\..*)?$ ]] ||
        die 'unsafe profile name: use 1-64 lowercase letters/digits, dots, underscores or hyphens; start with a letter/digit, no trailing dot or reserved device names'
}

native_flag_kind() {
    # Mirrored oh-my-pi v18.9.1 coding-agent/src/cli/flag-tables.ts.
    # --plan is bootstrap-shadowable; unknown long flags consume value-like
    # successors only. Inline values never consume a separate argv token.
    FLAG_KIND=none
    case "$1" in
        --plan) FLAG_KIND=shadow ;;
        --cwd|--config|--add-dir|--mode|--fork|--provider|--model|--smol|--slow|--goal|\
        --prewalk-into|--plan-yolo-into|--max-time|--service-tier|--api-key|\
        --system-prompt|--system-prompt-template|--append-system-prompt|\
        --provider-session-id|--prompt-cache-key|--session-dir|--models|--tools|\
        --thinking|--export|--hook|--extension|-e|--trusted-extension|--plugin-dir|\
        --skills|--approval-mode)
            FLAG_KIND=string ;;
        --resume|-r|--session) FLAG_KIND=optional ;;
        --help|--version|--allow-home|--continue|--from-claude|--from-codex|\
        --no-session|--no-tools|--no-lsp|--no-pty|--hide-thinking|--advisor|\
        --external-thinking|--prewalk|--no-prewalk|--plan-yolo|--print|--print-thoughts|\
        --no-extensions|--no-skills|--no-rules|--no-title|--no-ui|--auto-approve|--yolo|--*=*) ;;
        --*) FLAG_KIND=unknown ;;
    esac
}

native_consumes_value() {
    # Call only when a successor exists; empty optional values are rejected.
    case "$FLAG_KIND" in
        string) return 0 ;;
        optional) [[ -n "$1" && "$1" != -* ]] ;;
        shadow|unknown) [[ "$1" != -* ]] ;;
        *) return 1 ;;
    esac
}

native_is_subcommand() {
    # oh-my-pi v18.9.1 coding-agent/src/cli-commands.ts names + aliases.
    case "$1" in
        launch|acp|auth-broker|auth-gateway|agents|anonymize|bench|browser-relay|\
        cleanse|collab|commit|completions|__complete|compress|config|dry-balance|\
        find|gc|grep|gallery|git|grievances|images|img|if-bench|install|join|login|\
        models|plugin|plugins|predict|ps|say|clip|play|share|setup|shell|read|render|\
        skill|skills|ssh|stats|stream|update|usage|tiny-models|token|toks|ttsr|\
        worktree|wt|search|q|web-search) return 0 ;;
        *) return 1 ;;
    esac
}

parse_args() {
    OMP_ARGS=()
    WRAPPER_PROFILE=''
    DEBUG_MODE=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --opd-help) usage >&2; exit 0 ;;
            --opd-debug) DEBUG_MODE=true; shift ;;
            --opd-profile)
                [[ $# -ge 2 ]] || die '--opd-profile requires NAME'
                normalize_profile "$2"
                [[ -z "$WRAPPER_PROFILE" || "$WRAPPER_PROFILE" == "$NORMALIZED_PROFILE" ]] || die 'conflicting wrapper profiles'
                WRAPPER_PROFILE="$NORMALIZED_PROFILE"; shift 2 ;;
            --) shift; OMP_ARGS+=("$@"); break ;;
            *) OMP_ARGS+=("$1"); shift ;;
        esac
    done
    parse_native_args
}

parse_native_args() {
    # Mirror v18.9.1 cli/profile-bootstrap.ts without changing raw OMP_ARGS.
    # Only the first residual token can end global profile extraction at a
    # command boundary; launch/acp keep accepting launch-shaped global flags.
    local index arg value native_profile='' can_dispatch=true boundary=false
    local residual=()
    for ((index=0; index<${#OMP_ARGS[@]}; index++)); do
        arg="${OMP_ARGS[$index]}"
        if [[ "$boundary" == true ]]; then
            [[ "$arg" == -* ]] || residual+=(--omp-profile-boundary)
            boundary=false
        fi
        case "$arg" in
            --) residual+=("${OMP_ARGS[@]:$index}"); break ;;
            --profile|--profile=*|--alias|--alias=*)
                if [[ "$arg" == --profile || "$arg" == --alias ]]; then
                    index=$((index + 1))
                    [[ $index -lt ${#OMP_ARGS[@]} ]] || die "${arg} requires NAME"
                    value="${OMP_ARGS[$index]}"
                    [[ -n "$value" && "$value" != -* ]] || die "${arg} requires NAME"
                else
                    value="${arg#*=}"
                    [[ -n "$value" ]] || die "${arg%%=*} requires NAME"
                fi
                [[ "$arg" != --profile && "$arg" != --profile=* ]] || native_profile="$value"
                if [[ ${#residual[@]} -gt 0 ]]; then
                    native_flag_kind "${residual[${#residual[@]}-1]}"
                    case "$FLAG_KIND" in optional|shadow|unknown) boundary=true ;; esac
                fi
                continue ;;
        esac
        if [[ "$can_dispatch" == true && "$arg" != launch && "$arg" != acp ]] && native_is_subcommand "$arg"; then
            residual+=("${OMP_ARGS[@]:$index}"); break
        fi
        can_dispatch=false
        residual+=("$arg")
        native_flag_kind "$arg"
        if [[ $((index + 1)) -lt ${#OMP_ARGS[@]} ]] && native_consumes_value "${OMP_ARGS[$((index + 1))]}"; then
            index=$((index + 1))
            residual+=("${OMP_ARGS[$index]}")
        fi
    done
    # Select once, preserving a defined-empty native environment as default.
    local profile="${native_profile:-$WRAPPER_PROFILE}"
    if [[ -z "$profile" ]]; then
        profile="${OMP_PROFILE-${OPD_PROFILE-default}}"
    fi
    normalize_profile "$profile"
    SELECTED_PROFILE="$NORMALIZED_PROFILE"
    if [[ -n "$native_profile" && -n "$WRAPPER_PROFILE" && "$SELECTED_PROFILE" != "$WRAPPER_PROFILE" ]]; then
        die 'explicit --opd-profile and native --profile disagree'
    fi

    detect_machine_mode ${residual[@]+"${residual[@]}"}
}

detect_machine_mode() {
    local residual=("$@") index arg value can_dispatch
    # Resolve command ownership separately: unlike profile bootstrap, the native
    # resolver consumes any successor of --plan before looking for a command.
    MACHINE_MODE=false
    PROMPT_STDIN=false
    index=0; can_dispatch=true
    # resolveCliArgv leaves leading help/version untouched rather than hoisting
    # a later command-looking token such as `--help acp`.
    case "${residual[0]:-}" in --help|-h|--version|-v|help) can_dispatch=false ;; esac
    while [[ "$can_dispatch" == true && $index -lt ${#residual[@]} ]]; do
        arg="${residual[$index]}"
        [[ "$arg" != -- ]] || break
        if [[ "$arg" != -* ]]; then
            if native_is_subcommand "$arg"; then
                case "$arg" in
                    acp) MACHINE_MODE=true; return 0 ;;
                    launch) ;;
                    *) return 0 ;;
                esac
            fi
            break
        fi
        native_flag_kind "$arg"
        if [[ $((index + 1)) -lt ${#residual[@]} ]] &&
           { [[ "$FLAG_KIND" == shadow ]] || native_consumes_value "${residual[$((index + 1))]}"; }; then
            index=$((index + 1))
        fi
        index=$((index + 1))
    done

    # Print/ACP remain machine modes; repeated --mode uses its final valid value.
    local native_mode=text print_mode=false
    for ((index=0; index<${#residual[@]}; index++)); do
        arg="${residual[$index]}"
        [[ "$arg" != -- ]] || break
        case "$arg" in
            --print|-p) print_mode=true ;;
            --mode|--mode=*)
                if [[ "$arg" == --mode ]]; then
                    value="${residual[$((index + 1))]:-}"
                else
                    value="${arg#*=}"
                fi
                case "$value" in text|rpc-ui|rpc|json|acp) native_mode="$value" ;; esac ;;
        esac
        native_flag_kind "$arg"
        if [[ $((index + 1)) -lt ${#residual[@]} ]] && native_consumes_value "${residual[$((index + 1))]}"; then
            index=$((index + 1))
        fi
    done
    case "$native_mode" in text|json) PROMPT_STDIN=true ;; esac
    if [[ "$print_mode" == true ||
          "$native_mode" == rpc || "$native_mode" == json || "$native_mode" == acp ]]; then
        MACHINE_MODE=true
    fi
}

check_mount_path() {
    [[ "$1" != *,* ]] || die "Docker --mount cannot represent a comma in this path: $1"
}

prepare_data() {
    DATA_DIR="${OPD_DATA_DIR:-$SCRIPT_DIR/data}"
    [[ "$DATA_DIR" == /* ]] || die 'OPD_DATA_DIR must be absolute'
    # Strip terminal directory syntax before testing the root itself for links.
    while [[ "$DATA_DIR" != / ]]; do
        case "$DATA_DIR" in
            */) DATA_DIR="${DATA_DIR%/}" ;;
            */.) DATA_DIR="${DATA_DIR%/.}" ;;
            *) break ;;
        esac
        DATA_DIR="${DATA_DIR:-/}"
    done
    [[ ! -L "$DATA_DIR" ]] || die 'refusing symlinked persistent home; use a real directory'
    mkdir -p -- "$DATA_DIR" || die 'cannot create persistent home; check permissions and build UID/GID'
    DATA_DIR="$(CDPATH= cd -P -- "$DATA_DIR" && pwd)"
    [[ "$DATA_DIR" != / ]] || die 'refusing to use / as the persistent home'
    check_mount_path "$DATA_DIR"
    local component path="$DATA_DIR" components=(.omp)
    if [[ "$SELECTED_PROFILE" != default ]]; then
        components+=(profiles "$SELECTED_PROFILE")
    fi
    components+=(agent)
    for component in "${components[@]}"; do
        path="$path/$component"
        [[ ! -L "$path" ]] || die "refusing to seed through symlink: $path"
        mkdir -p -- "$path" || die 'cannot create native state directory; check data ownership and build UID/GID'
        [[ -d "$path" && -w "$path" ]] || die "agent directory is not writable: $path"
    done
    AGENT_DIR="$path"
    # Native brokers chmod Unix sockets, which host-shared filesystems may reject.
    # Check mount targets without following linked runtime directories.
    local runtime_dir runtime_dirs=("$DATA_DIR/.omp/run")
    [[ "$SELECTED_PROFILE" == default ]] || runtime_dirs+=("${AGENT_DIR%/agent}/run")
    for runtime_dir in "${runtime_dirs[@]}"; do
        [[ ! -L "$runtime_dir" ]] || die "refusing symlinked runtime directory: $runtime_dir"
        mkdir -p -- "$runtime_dir" || die 'cannot create native runtime mount directory'
    done
    local template="$SCRIPT_DIR/config/profiles/$SELECTED_PROFILE.yml"
    [[ -f "$template" ]] || template="$SCRIPT_DIR/config/config.yml"
    seed_config "$template" config.yml config.yaml settings.json
    if [[ -f "$SCRIPT_DIR/config/models.yml" ]]; then
        seed_config "$SCRIPT_DIR/config/models.yml" models.yml models.yaml models.json
    fi
}

seed_config() {
    local template="$1" filename="$2" existing
    shift
    for existing in "$@"; do
        [[ ! -e "$AGENT_DIR/$existing" && ! -L "$AGENT_DIR/$existing" ]] || return 0
    done
    [[ -f "$template" && -r "$template" ]] || die "missing readable config template: $template"
    # noclobber also protects a config created concurrently by another launcher.
    if ! (set -o noclobber; umask 077; cat -- "$template" > "$AGENT_DIR/$filename") 2>/dev/null; then
        [[ -e "$AGENT_DIR/$filename" || -L "$AGENT_DIR/$filename" ]] || die "could not seed $filename"
    fi
}

prepare_display() {
    DISPLAY_ARGS=()
    HOST_DISPLAY=''
    X11_STATUS='not mounted'
    XAUTHORITY_STATUS='not mounted'
    local host_display="${OPD_DISPLAY-${DISPLAY:-}}" xhost_bin xhost_display authority
    [[ ! ${OPD_DISPLAY+x} || -n "$OPD_DISPLAY" ]] || return 0
    case "$(uname -s)" in
        Darwin)
            if [[ -d /Applications/Utilities/XQuartz.app || -d /Applications/XQuartz.app ]]; then
                /usr/bin/open -g -a XQuartz >/dev/null 2>&1 || true
                xhost_bin="$(command -v xhost || true)"
                [[ -n "$xhost_bin" || ! -x /opt/X11/bin/xhost ]] || xhost_bin=/opt/X11/bin/xhost
                if [[ -n "$xhost_bin" ]]; then
                    xhost_display="${DISPLAY:-:0}"
                    DISPLAY="$xhost_display" "$xhost_bin" +127.0.0.1 >/dev/null 2>&1 || true
                    DISPLAY="$xhost_display" "$xhost_bin" +localhost >/dev/null 2>&1 || true
                fi
            fi
            if [[ ! ${OPD_DISPLAY+x} ]]; then
                case "$host_display" in
                    ''|:*|/tmp/*|/private/tmp/*|/var/run/com.apple.launchd.*) host_display=host.docker.internal:0 ;;
                esac
            fi ;;
        Linux)
            if [[ -n "$host_display" && -d /tmp/.X11-unix ]]; then
                DISPLAY_ARGS+=(--mount type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,readonly)
                X11_STATUS='/tmp/.X11-unix -> /tmp/.X11-unix (read-only)'
            fi
            if [[ -n "$host_display" && -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" && -r "$XAUTHORITY" ]]; then
                authority="$(CDPATH= cd -P -- "$(dirname -- "$XAUTHORITY")" && pwd)/$(basename -- "$XAUTHORITY")"
                check_mount_path "$authority"
                DISPLAY_ARGS+=(--mount "type=bind,source=$authority,target=/tmp/.docker.xauth,readonly" -e XAUTHORITY=/tmp/.docker.xauth)
                XAUTHORITY_STATUS='/tmp/.docker.xauth (read-only)'
            fi ;;
    esac
    [[ -z "$host_display" ]] || DISPLAY_ARGS+=(-e "DISPLAY=$host_display")
    HOST_DISPLAY="$host_display"
}

cleanup() {
    if [[ -n "${TTY_STATE:-}" && -t 0 ]]; then
        stty "$TTY_STATE" 2>/dev/null || true
    fi
    if [[ "${USED_TTY:-false}" == true && -t 1 ]]; then
        printf '\033[?1000l\033[?1002l\033[?1003l\033[?1004l\033[?1006l\033[?2004l\033[?25h\033[0m' >&2
    fi
}

handle_signal() {
    local signal="$1" status="$2"
    # wait is interruptible, unlike a foreground external command in Bash.
    trap '' INT TERM HUP
    if [[ -n "${DOCKER_PID:-}" ]]; then
        kill -s "$signal" "$DOCKER_PID" 2>/dev/null || true
    fi
    exit "$status"
}

prepare_runtime() {
    local tool
    for tool in dirname readlink mkdir cat uname date; do
        command -v "$tool" >/dev/null 2>&1 || die "required host tool '$tool' is missing; install it and retry"
    done
    resolve_script_dir
    IMAGE_NAME="${OPD_IMAGE:-opd:latest}"
    command -v docker >/dev/null 2>&1 || die "Docker is not installed or not on PATH. Install/start Docker, then run $SCRIPT_DIR/build."
    docker info >/dev/null 2>&1 || die 'Docker daemon unavailable; start Docker/Docker Desktop and check context/socket permissions'
    docker image inspect "$IMAGE_NAME" >/dev/null 2>&1 || die "image '$IMAGE_NAME' unavailable. Run $SCRIPT_DIR/build; or build/pull the custom OPD_IMAGE tag."
    check_mount_path "$SCRIPT_DIR/config"
}

prepare_workspace() {
    CURRENT_DIR="$(pwd -P)"
    check_mount_path "$CURRENT_DIR"
    local basename="${CURRENT_DIR##*/}" digest
    basename="${basename//[^A-Za-z0-9._-]/-}"
    basename="${basename#-}"; basename="${basename%-}"
    basename="${basename:-workspace}"
    if command -v sha256sum >/dev/null 2>&1; then
        digest="$(printf '%s' "$CURRENT_DIR" | sha256sum)"
    elif command -v shasum >/dev/null 2>&1; then
        digest="$(printf '%s' "$CURRENT_DIR" | shasum -a 256)"
    else
        die 'sha256sum or shasum is required'
    fi
    CONTAINER_WORKSPACE="/workspaces/$basename-${digest:0:12}"
}

print_start_banner() {
    [[ -z "${OPD_NO_BANNER:-}" ]] || return 0
    if [[ "$USED_TTY" == true && -t 2 ]]; then
        cat >&2 <<'EOF'
                   o
                  / \
           o-----o---o-----o
          /       \ /       \
         o         o         o
                   |
                                   88
                                   88
   ,adPPYba,  8b,dPPYba,   ,adPPYb,88
  a8"  o  "8a 88P'    "8a a8"    `Y88
  8b   |   d8 88       d8 8b---o---88
  "8a,-o-,a8" 88b,   ,a8" "8a,-|-,d88
   `"YbbdP"'  88`YbbdP"'   `"8bbdP"Y8
              88
              88

EOF
    fi
    local terminal='not allocated (non-terminal stdin/stdout)' cleanup='remove container on exit'
    [[ "$MACHINE_MODE" != true ]] || terminal='not allocated (print/protocol mode)'
    [[ "$USED_TTY" != true ]] || terminal='allocated'
    [[ "$DEBUG_MODE" != true ]] || cleanup='preserve container (--opd-debug)'
    printf 'Launch details:\n'
    printf '  Image: %s\n  Container: %s\n  Profile: %s\n' "$IMAGE_NAME" "$CONTAINER_NAME" "$SELECTED_PROFILE"
    printf '  Terminal: %s\n  Cleanup: %s\n' "$terminal" "$cleanup"
    printf '  Workspace: %s -> %s (read/write)\n' "$CURRENT_DIR" "$CONTAINER_WORKSPACE"
    printf '  Persistent home: %s -> /home/coder (read/write)\n' "$DATA_DIR"
    printf '  Profile state: %s -> %s (persistent settings/auth/sessions)\n' "$AGENT_DIR" "/home/coder${AGENT_DIR#"$DATA_DIR"}"
    printf '  Repository config: %s -> /config/opd (read-only; not a settings overlay)\n' "$SCRIPT_DIR/config"
    printf '  Runtime sockets: container-local tmpfs (ephemeral)\n'
    printf '  Display: %s\n  X11 socket: %s\n  Xauthority: %s\n' "${HOST_DISPLAY:-disabled}" "$X11_STATUS" "$XAUTHORITY_STATUS"
    printf '  Network: host (host services accessible)\n\n'
}

run_container() {
    CONTAINER_NAME="opd-$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
    local docker_args=(run -i) variable status
    USED_TTY=false
    if [[ -t 0 && -t 1 && "$MACHINE_MODE" == false ]]; then
        docker_args+=(-t); USED_TTY=true
        TTY_STATE="$(stty -g 2>/dev/null || true)"
    fi
    [[ "$DEBUG_MODE" == true ]] || docker_args+=(--rm)
    docker_args+=(--init --entrypoint '' --name "$CONTAINER_NAME" --network host --shm-size=1g
        --user coder --security-opt no-new-privileges:true --cap-drop ALL
        --cap-add CHOWN --cap-add SETUID --cap-add SETGID
        --mount "type=bind,source=$DATA_DIR,target=/home/coder"
        --tmpfs /home/coder/.omp/run:rw,nosuid,nodev,mode=1777
        --mount "type=bind,source=$CURRENT_DIR,target=$CONTAINER_WORKSPACE"
        --mount "type=bind,source=$SCRIPT_DIR/config,target=/config/opd,readonly"
        -w "$CONTAINER_WORKSPACE" -e HOME=/home/coder
        -e PATH=/home/coder/.local/bin:/home/coder/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        -e "TERM=${TERM:-xterm-256color}" -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8
        -e "OMP_PROFILE=$SELECTED_PROFILE")
    if [[ "$SELECTED_PROFILE" != default ]]; then
        docker_args+=(--tmpfs "/home/coder/.omp/profiles/$SELECTED_PROFILE/run:rw,nosuid,nodev,mode=1777")
    fi
    for variable in \
        OPENAI_API_KEY OPENAI_CODEX_OAUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_OAUTH_TOKEN \
        GEMINI_API_KEY GOOGLE_API_KEY OPENROUTER_API_KEY GROQ_API_KEY MISTRAL_API_KEY \
        XAI_API_KEY DEEPSEEK_API_KEY OLLAMA_API_KEY OLLAMA_HOST OLLAMA_BASE_URL \
        AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_REGION \
        AWS_DEFAULT_REGION AWS_PROFILE; do
        if [[ ${!variable+x} ]]; then
            docker_args+=(-e "$variable")
        fi
    done
    docker_args+=(${DISPLAY_ARGS[@]+"${DISPLAY_ARGS[@]}"} "$IMAGE_NAME" /usr/local/bin/omp ${OMP_ARGS[@]+"${OMP_ARGS[@]}"})
    trap cleanup EXIT
    trap 'handle_signal INT 130' INT
    trap 'handle_signal TERM 143' TERM
    trap 'handle_signal HUP 129' HUP
    print_start_banner >&2
    if [[ "$DEBUG_MODE" == true ]]; then
        printf 'Debug container: %s\n  docker logs %s\n  docker inspect %s\n  docker rm %s\n' "$CONTAINER_NAME" "$CONTAINER_NAME" "$CONTAINER_NAME" "$CONTAINER_NAME" >&2
    fi
    if [[ "$USED_TTY" == true && -t 2 && -z "${OPD_NO_BANNER:-}" ]]; then
        sleep 2
    fi
    status=0
    # Without a container TTY, native prompt startup reads stdin until EOF.
    # A host terminal is not a piped prompt; protocol/subcommand input stays live.
    if [[ -t 0 && "$USED_TTY" == false && "$PROMPT_STDIN" == true ]]; then
        docker "${docker_args[@]}" </dev/null &
    else
        docker "${docker_args[@]}" <&0 &
    fi
    DOCKER_PID=$!
    wait "$DOCKER_PID" || status=$?
    DOCKER_PID=''
    [[ "$DEBUG_MODE" != true ]] || printf 'Docker exited with status %s; container %s retained if created.\n' "$status" "$CONTAINER_NAME" >&2
    exit "$status"
}

main() {
    parse_args "$@"
    prepare_runtime
    prepare_workspace
    prepare_data
    prepare_display
    run_container
}

main "$@"
