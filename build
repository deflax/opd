#!/usr/bin/env bash
set -euo pipefail

# Resolve the real script location, including relative and chained symlinks.
script_path=${BASH_SOURCE[0]}
[[ $script_path = /* ]] || script_path="$PWD/$script_path"
links=0
while [[ -L $script_path ]]; do
    script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)
    script_path=$(readlink "$script_path")
    [[ $script_path = /* ]] || script_path="$script_dir/$script_path"
    links=$((links + 1))
    if (( links > 40 )); then
        printf 'Cannot resolve build script: too many symbolic links\n' >&2
        exit 1
    fi
done
script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)

# Only the first argument selects the base build; remaining args belong to Docker.
base_image=${OPD_BASE_IMAGE:-opd-base:latest}
if [[ ${1:-} = --base ]]; then
    shift
    exec docker build \
        --file "$script_dir/Dockerfile.base" \
        --tag "$base_image" \
        "$@" \
        "$script_dir"
fi

# Keep the expensive toolchain image independent of omp-only rebuild options.
if ! docker image inspect "$base_image" >/dev/null 2>&1; then
    printf 'Base image unavailable; building Debian toolchain first\n' >&2
    docker build \
        --file "$script_dir/Dockerfile.base" \
        --tag "$base_image" \
        "$script_dir"
fi

# Docker Desktop mounts do not require macOS's 501/staff identity in the image.
if [[ $(uname -s) = Darwin ]]; then
    user_uid=1000
    user_gid=1000
else
    user_uid=$(id -u)
    user_gid=$(id -g)
fi

exec docker build \
    --file "$script_dir/Dockerfile" \
    --tag "${OPD_IMAGE:-opd:latest}" \
    --build-arg "BASE_IMAGE=$base_image" \
    --build-arg "USER_UID=$user_uid" \
    --build-arg "USER_GID=$user_gid" \
    "$@" \
    "$script_dir"
